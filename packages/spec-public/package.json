{
  "name": "@nearpay/spec",
  "version": "0.4.2",
  "description": "NearPay public contracts: REST routes and objects, webhook events and signatures, the NearPay x402 scheme, NEAR Intents payloads and the error catalogue (zod 4).",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/public-entry.d.ts",
      "import": "./dist/public-entry.js"
    },
    "./test-vectors/*": "./test-vectors/*",
    "./openapi/*": "./openapi/*",
    "./schemas/*": "./schemas/*",
    "./errors/*": "./errors/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "test-vectors",
    "openapi",
    "schemas",
    "errors",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.11.0"
  },
  "peerDependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "zod": "4.6.7"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs public"
  }
}
