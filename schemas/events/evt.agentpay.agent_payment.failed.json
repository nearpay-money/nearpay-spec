{
  "$defs": {
    "AgentPayment": {
      "additionalProperties": {},
      "description": "A payer-signed NEAR Intents payment relayed by NearPay.",
      "properties": {
        "amount": {
          "description": "Amount to the merchant, base units.",
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "type": "string"
        },
        "asset_id": {
          "description": "Asset.",
          "examples": [
            "nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1"
          ],
          "maxLength": 256,
          "pattern": "^(nep141:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+|nep245:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+:[\\x21-\\x7e]{1,128})$",
          "type": "string"
        },
        "binding": {
          "description": "Binding memo `np1:` + base58(sha256(…)) tying a signed transfer to one requirement.",
          "pattern": "^np1:[1-9A-HJ-NP-Za-km-z]{43,44}$",
          "type": "string"
        },
        "block_height": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Block of the transaction."
        },
        "checkout_session": {
          "anyOf": [
            {
              "description": "checkout_session id (`cs_` + 26 base32 chars).",
              "examples": [
                "cs_01jbz9k3m4n5p6q7r8s9t0v1w2"
              ],
              "pattern": "^cs_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Checkout session paid (checkout kind)."
        },
        "created": {
          "description": "Unix time in seconds.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "error_reason": {
          "description": "Why it failed.",
          "type": [
            "string",
            "null"
          ]
        },
        "fee_amount": {
          "description": "NearPay fee, base units.",
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "type": "string"
        },
        "id": {
          "description": "agent_payment id (`ap_` + 26 base32 chars).",
          "examples": [
            "ap_01jbz9k3m4n5p6q7r8s9t0v1w2"
          ],
          "pattern": "^ap_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
          "type": "string"
        },
        "kind": {
          "description": "What the signed payload paid for.",
          "type": "string",
          "x-extensible-enum": [
            "x402",
            "checkout",
            "refund"
          ]
        },
        "livemode": {
          "description": "`true` for live mode, `false` for test mode.",
          "type": "boolean"
        },
        "object": {
          "const": "agent_payment",
          "description": "Always `agent_payment`.",
          "type": "string"
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentPaymentOrigin"
            },
            {
              "type": "null"
            }
          ],
          "description": "`near-intents` only (null otherwise): the cross-chain deposit. For `near-intents`, `payer` is the NEAR Intents account that delivered the funds to `pay_to` (from the evidence), `amount` the delivered amount and `fee_amount` `0` (NearPay's fee is taken from the deposit: `origin.fee`). Spec 0.3.0."
        },
        "pay_to": {
          "description": "Receiving Intents account: the merchant (`x402`, `checkout`) or, for a `refund`, the payer's Intents account or the 1Click deposit account of a route refund.",
          "pattern": "^(?=.{2,64}$)(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+$",
          "type": "string"
        },
        "payer": {
          "description": "Intents account that signed: the payer (`x402`, `checkout`) or, for a `refund`, the merchant's Intents destination sending the refund.",
          "pattern": "^(?=.{2,64}$)(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+$",
          "type": "string"
        },
        "refund": {
          "anyOf": [
            {
              "description": "refund id (`re_` + 26 base32 chars).",
              "examples": [
                "re_01jbz9k3m4n5p6q7r8s9t0v1w2"
              ],
              "pattern": "^re_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Refund this payload pays a leg of (`refund` kind); null otherwise. Spec 0.2.1."
        },
        "resource_url": {
          "anyOf": [
            {
              "format": "uri",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Paid resource (x402)."
        },
        "sequence": {
          "description": "Increases with every change; discard webhook objects with a lower sequence. Servers MUST send it (optional in the 0.1.x schema only so readers built on 0.1.4 stay compatible).",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "settled_at": {
          "anyOf": [
            {
              "description": "Unix time in seconds.",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "When it settled (final)."
        },
        "status": {
          "description": "Relay status.",
          "type": "string",
          "x-extensible-enum": [
            "verified",
            "queued",
            "submitted",
            "settled",
            "failed"
          ]
        },
        "transfer_method": {
          "description": "How the payment reached the merchant: a payer-signed Verifier payload (`intents-transfer`) or a cross-chain 1Click deposit (`near-intents`, kind `x402` only). Absent from servers older than spec 0.3.0 (= `intents-transfer`).",
          "type": "string",
          "x-extensible-enum": [
            "intents-transfer",
            "near-intents"
          ]
        },
        "tx_hash": {
          "anyOf": [
            {
              "description": "Transaction hash in the chain's text form.",
              "maxLength": 128,
              "minLength": 8,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "NEAR transaction that executed the payload."
        }
      },
      "required": [
        "id",
        "object",
        "created",
        "livemode",
        "kind",
        "status",
        "payer",
        "pay_to",
        "asset_id",
        "amount",
        "fee_amount",
        "binding",
        "resource_url",
        "checkout_session",
        "tx_hash",
        "block_height",
        "error_reason",
        "settled_at"
      ],
      "type": "object"
    },
    "AgentPaymentOrigin": {
      "additionalProperties": {},
      "description": "The cross-chain deposit behind a `near-intents` agent payment.",
      "properties": {
        "amount_in": {
          "anyOf": [
            {
              "description": "Asset amount in base units as a decimal string (no sign, no decimals, ≤ 78 digits).",
              "pattern": "^(0|[1-9][0-9]{0,77})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the payer deposited, base units of `asset_id`; null if not reported."
        },
        "asset_id": {
          "description": "Origin asset (NEAR Intents id).",
          "examples": [
            "nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1"
          ],
          "maxLength": 256,
          "pattern": "^(nep141:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+|nep245:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+:[\\x21-\\x7e]{1,128})$",
          "type": "string"
        },
        "deposit_address": {
          "description": "1Click deposit address the payer paid.",
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "deposit_memo": {
          "description": "Deposit memo, if the origin network needs one.",
          "type": [
            "string",
            "null"
          ]
        },
        "fee": {
          "anyOf": [
            {
              "additionalProperties": {},
              "properties": {
                "amount": {
                  "description": "Fee, base units of `asset_id`.",
                  "pattern": "^(0|[1-9][0-9]{0,77})$",
                  "type": "string"
                },
                "asset_id": {
                  "description": "Asset the fee was taken in.",
                  "examples": [
                    "nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1"
                  ],
                  "maxLength": 256,
                  "pattern": "^(nep141:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+|nep245:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+:[\\x21-\\x7e]{1,128})$",
                  "type": "string"
                }
              },
              "required": [
                "amount",
                "asset_id"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "description": "NearPay's fee as observed for the route (provider app fee); null when not reported."
        },
        "network": {
          "description": "Origin network (CAIP-2) the payer deposited on.",
          "examples": [
            "eip155:8453"
          ],
          "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$",
          "type": "string"
        },
        "refund_to": {
          "description": "The payer's refund address on the origin network (from the quote payload).",
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "tx_hashes": {
          "description": "Deposit transactions on the origin network.",
          "items": {
            "description": "Transaction hash in the chain's text form.",
            "maxLength": 128,
            "minLength": 8,
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "network",
        "asset_id",
        "amount_in",
        "refund_to",
        "deposit_address",
        "deposit_memo",
        "tx_hashes",
        "fee"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "description": "Envelope of `evt.agentpay.agent_payment.failed`.",
  "properties": {
    "account_id": {
      "anyOf": [
        {
          "description": "UUID (RFC 9562).",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Merchant account UUID (null for platform events)."
    },
    "aggregate": {
      "additionalProperties": {},
      "description": "The aggregate that changed.",
      "properties": {
        "id": {
          "description": "Aggregate id (prefixed).",
          "type": "string"
        },
        "type": {
          "description": "Aggregate type.",
          "type": "string"
        },
        "version": {
          "description": "Aggregate version after the change.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "type",
        "id",
        "version"
      ],
      "type": "object"
    },
    "data": {
      "additionalProperties": {},
      "description": "Payload.",
      "properties": {
        "object": {
          "$ref": "#/$defs/AgentPayment"
        },
        "previous": {
          "additionalProperties": {},
          "description": "Changed fields with previous values.",
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "object"
      ],
      "type": "object"
    },
    "id": {
      "description": "Event id (UUIDv7); also the NATS `Nats-Msg-Id` for de-duplication.",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
    },
    "livemode": {
      "description": "Mode (null for platform events).",
      "type": [
        "boolean",
        "null"
      ]
    },
    "occurred_at": {
      "description": "When the state change committed.",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    },
    "request": {
      "additionalProperties": {},
      "description": "Request context (copied into public events).",
      "properties": {
        "id": {
          "anyOf": [
            {
              "description": "Request id, also returned in the `X-Request-Id` header.",
              "examples": [
                "req_01jbz9k3m4n5p6q7r8s9t0v1w2"
              ],
              "pattern": "^req_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "API request that caused the change."
        },
        "idempotency_key": {
          "description": "Its Idempotency-Key.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "idempotency_key"
      ],
      "type": "object"
    },
    "subject": {
      "const": "evt.agentpay.agent_payment.failed",
      "description": "Subject.",
      "type": "string"
    },
    "trace": {
      "additionalProperties": {},
      "description": "Trace context.",
      "properties": {
        "traceparent": {
          "description": "W3C traceparent.",
          "type": "string"
        }
      },
      "required": [
        "traceparent"
      ],
      "type": "object"
    }
  },
  "required": [
    "id",
    "occurred_at",
    "account_id",
    "livemode",
    "aggregate",
    "subject",
    "data"
  ],
  "type": "object"
}
