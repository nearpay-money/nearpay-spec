{
  "$defs": {
    "VaultEvent": {
      "description": "A subscription-vault NEP-297 event (contracts-vault §4.1). Valid only in a successful receipt executed by the vault account itself (rails §8.6).",
      "oneOf": [
        {
          "additionalProperties": {},
          "description": "`mandate_created` event.",
          "properties": {
            "data": {
              "description": "One-element array (NEP-141/171 convention).",
              "items": false,
              "maxItems": 1,
              "minItems": 1,
              "prefixItems": [
                {
                  "additionalProperties": {},
                  "description": "`mandate_created` data.",
                  "properties": {
                    "amount_per_period": {
                      "description": "Tokens collected per period (base units).",
                      "pattern": "^(0|[1-9][0-9]{0,38})$",
                      "type": "string"
                    },
                    "balance": {
                      "description": "Initial funding (base units).",
                      "pattern": "^(0|[1-9][0-9]{0,38})$",
                      "type": "string"
                    },
                    "ext_ref": {
                      "description": "Free reference (≤ 64 bytes printable ASCII); NearPay puts the subscription id (`sub_…`).",
                      "maxLength": 64,
                      "pattern": "^[\\x20-\\x7e]*$",
                      "type": "string"
                    },
                    "fee_bps": {
                      "description": "NearPay fee in basis points, fixed at creation.",
                      "maximum": 10000,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "mandate_id": {
                      "description": "On-chain mandate id (u64, sequential from 0; exact in JSON numbers far beyond any real count).",
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "max_periods": {
                      "anyOf": [
                        {
                          "maximum": 2147483647,
                          "minimum": 1,
                          "type": "integer"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "Number of periods the mandate may collect; null = unlimited."
                    },
                    "merchant_receiver": {
                      "description": "Receiver of the merchant share (an Intents account for NearPay).",
                      "pattern": "^(?=.{2,64}$)(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+$",
                      "type": "string"
                    },
                    "payer": {
                      "description": "Payer = the NEP-141 `sender_id`, which is always the transaction signer (v1.5).",
                      "pattern": "^(?=.{2,64}$)(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+$",
                      "type": "string"
                    },
                    "period_secs": {
                      "description": "Period length in seconds (86 400 … 379 468 800).",
                      "maximum": 379468800,
                      "minimum": 86400,
                      "type": "integer"
                    },
                    "receiver_kind": {
                      "description": "How the merchant share is delivered: `intents_account` = `ft_transfer_call(intents.near, msg = merchant_receiver)` (credits the merchant's NEAR Intents balance); `near_account` = plain `ft_transfer`.",
                      "enum": [
                        "intents_account",
                        "near_account"
                      ],
                      "type": "string"
                    },
                    "start_at": {
                      "description": "When period 1 becomes due (ns); a past or omitted `start_at` became the block time.",
                      "pattern": "^(0|[1-9][0-9]{0,19})$",
                      "type": "string"
                    },
                    "token": {
                      "description": "NEP-141 token contract (the calling token).",
                      "pattern": "^(?=.{2,64}$)(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "mandate_id",
                    "payer",
                    "merchant_receiver",
                    "token",
                    "amount_per_period",
                    "period_secs",
                    "start_at",
                    "max_periods",
                    "fee_bps",
                    "ext_ref",
                    "receiver_kind",
                    "balance"
                  ],
                  "type": "object"
                }
              ],
              "type": "array"
            },
            "event": {
              "const": "mandate_created",
              "description": "Event name.",
              "type": "string"
            },
            "standard": {
              "const": "nearpay_vault",
              "description": "Always `nearpay_vault`.",
              "type": "string"
            },
            "version": {
              "const": "1.0.0",
              "description": "Always `1.0.0`.",
              "type": "string"
            }
          },
          "required": [
            "standard",
            "version",
            "event",
            "data"
          ],
          "type": "object"
        },
        {
          "additionalProperties": {},
          "description": "`topped_up` event.",
          "properties": {
            "data": {
              "description": "One-element array (NEP-141/171 convention).",
              "items": false,
              "maxItems": 1,
              "minItems": 1,
              "prefixItems": [
                {
                  "additionalProperties": {},
                  "description": "`topped_up` data.",
                  "properties": {
                    "amount": {
                      "description": "Deposited amount.",
                      "pattern": "^(0|[1-9][0-9]{0,38})$",
                      "type": "string"
                    },
                    "balance": {
                      "description": "Balance after the deposit.",
                      "pattern": "^(0|[1-9][0-9]{0,38})$",
                      "type": "string"
                    },
                    "mandate_id": {
                      "description": "On-chain mandate id (u64, sequential from 0; exact in JSON numbers far beyond any real count).",
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "mandate_id",
                    "amount",
                    "balance"
                  ],
                  "type": "object"
                }
              ],
              "type": "array"
            },
            "event": {
              "const": "topped_up",
              "description": "Event name.",
              "type": "string"
            },
            "standard": {
              "const": "nearpay_vault",
              "description": "Always `nearpay_vault`.",
              "type": "string"
            },
            "version": {
              "const": "1.0.0",
              "description": "Always `1.0.0`.",
              "type": "string"
            }
          },
          "required": [
            "standard",
            "version",
            "event",
            "data"
          ],
          "type": "object"
        },
        {
          "additionalProperties": {},
          "description": "`collected` event.",
          "properties": {
            "data": {
              "description": "One-element array (NEP-141/171 convention).",
              "items": false,
              "maxItems": 1,
              "minItems": 1,
              "prefixItems": [
                {
                  "additionalProperties": {},
                  "description": "`collected` data.",
                  "properties": {
                    "amount": {
                      "description": "`merchant_share + fee` actually paid.",
                      "pattern": "^(0|[1-9][0-9]{0,38})$",
                      "type": "string"
                    },
                    "balance": {
                      "description": "Balance after the period.",
                      "pattern": "^(0|[1-9][0-9]{0,38})$",
                      "type": "string"
                    },
                    "fee": {
                      "description": "Fee sent to the treasury; `\"0\"` when the fee leg failed or after a partial delivery.",
                      "pattern": "^(0|[1-9][0-9]{0,38})$",
                      "type": "string"
                    },
                    "mandate_id": {
                      "description": "On-chain mandate id (u64, sequential from 0; exact in JSON numbers far beyond any real count).",
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "merchant_share": {
                      "description": "Share delivered to the merchant receiver; below `floor(amount_per_period × (10000 − fee_bps) / 10000)` only on partial delivery (the period still counts).",
                      "pattern": "^(0|[1-9][0-9]{0,38})$",
                      "type": "string"
                    },
                    "period": {
                      "description": "1-based period that was counted.",
                      "maximum": 9007199254740991,
                      "minimum": 1,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "mandate_id",
                    "period",
                    "amount",
                    "merchant_share",
                    "fee",
                    "balance"
                  ],
                  "type": "object"
                }
              ],
              "type": "array"
            },
            "event": {
              "const": "collected",
              "description": "Event name.",
              "type": "string"
            },
            "standard": {
              "const": "nearpay_vault",
              "description": "Always `nearpay_vault`.",
              "type": "string"
            },
            "version": {
              "const": "1.0.0",
              "description": "Always `1.0.0`.",
              "type": "string"
            }
          },
          "required": [
            "standard",
            "version",
            "event",
            "data"
          ],
          "type": "object"
        },
        {
          "additionalProperties": {},
          "description": "`collect_failed` event.",
          "properties": {
            "data": {
              "description": "One-element array (NEP-141/171 convention).",
              "items": false,
              "maxItems": 1,
              "minItems": 1,
              "prefixItems": [
                {
                  "additionalProperties": {},
                  "description": "`collect_failed` data.",
                  "properties": {
                    "mandate_id": {
                      "description": "On-chain mandate id (u64, sequential from 0; exact in JSON numbers far beyond any real count).",
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "period": {
                      "description": "Period that was attempted (not counted).",
                      "maximum": 9007199254740991,
                      "minimum": 1,
                      "type": "integer"
                    },
                    "reason": {
                      "description": "Why: `merchant_transfer_failed` (the merchant leg delivered nothing; the only reason in v1).",
                      "type": "string",
                      "x-extensible-enum": [
                        "merchant_transfer_failed"
                      ]
                    }
                  },
                  "required": [
                    "mandate_id",
                    "period",
                    "reason"
                  ],
                  "type": "object"
                }
              ],
              "type": "array"
            },
            "event": {
              "const": "collect_failed",
              "description": "Event name.",
              "type": "string"
            },
            "standard": {
              "const": "nearpay_vault",
              "description": "Always `nearpay_vault`.",
              "type": "string"
            },
            "version": {
              "const": "1.0.0",
              "description": "Always `1.0.0`.",
              "type": "string"
            }
          },
          "required": [
            "standard",
            "version",
            "event",
            "data"
          ],
          "type": "object"
        },
        {
          "additionalProperties": {},
          "description": "`canceled` event.",
          "properties": {
            "data": {
              "description": "One-element array (NEP-141/171 convention).",
              "items": false,
              "maxItems": 1,
              "minItems": 1,
              "prefixItems": [
                {
                  "additionalProperties": {},
                  "description": "`canceled` data.",
                  "properties": {
                    "by": {
                      "description": "Who canceled: the payer or the merchant receiver.",
                      "pattern": "^(?=.{2,64}$)(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+$",
                      "type": "string"
                    },
                    "mandate_id": {
                      "description": "On-chain mandate id (u64, sequential from 0; exact in JSON numbers far beyond any real count).",
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "refunded": {
                      "description": "Amount actually returned to the payer; `\"0\"` when the refund failed (then withdrawable).",
                      "pattern": "^(0|[1-9][0-9]{0,38})$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "mandate_id",
                    "by",
                    "refunded"
                  ],
                  "type": "object"
                }
              ],
              "type": "array"
            },
            "event": {
              "const": "canceled",
              "description": "Event name.",
              "type": "string"
            },
            "standard": {
              "const": "nearpay_vault",
              "description": "Always `nearpay_vault`.",
              "type": "string"
            },
            "version": {
              "const": "1.0.0",
              "description": "Always `1.0.0`.",
              "type": "string"
            }
          },
          "required": [
            "standard",
            "version",
            "event",
            "data"
          ],
          "type": "object"
        },
        {
          "additionalProperties": {},
          "description": "`withdrawn` event.",
          "properties": {
            "data": {
              "description": "One-element array (NEP-141/171 convention).",
              "items": false,
              "maxItems": 1,
              "minItems": 1,
              "prefixItems": [
                {
                  "additionalProperties": {},
                  "description": "`withdrawn` data.",
                  "properties": {
                    "amount": {
                      "description": "Amount returned to the payer.",
                      "pattern": "^(0|[1-9][0-9]{0,38})$",
                      "type": "string"
                    },
                    "mandate_id": {
                      "description": "On-chain mandate id (u64, sequential from 0; exact in JSON numbers far beyond any real count).",
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "mandate_id",
                    "amount"
                  ],
                  "type": "object"
                }
              ],
              "type": "array"
            },
            "event": {
              "const": "withdrawn",
              "description": "Event name.",
              "type": "string"
            },
            "standard": {
              "const": "nearpay_vault",
              "description": "Always `nearpay_vault`.",
              "type": "string"
            },
            "version": {
              "const": "1.0.0",
              "description": "Always `1.0.0`.",
              "type": "string"
            }
          },
          "required": [
            "standard",
            "version",
            "event",
            "data"
          ],
          "type": "object"
        },
        {
          "additionalProperties": {},
          "description": "`exhausted` event.",
          "properties": {
            "data": {
              "description": "One-element array (NEP-141/171 convention).",
              "items": false,
              "maxItems": 1,
              "minItems": 1,
              "prefixItems": [
                {
                  "additionalProperties": {},
                  "description": "`exhausted` data.",
                  "properties": {
                    "mandate_id": {
                      "description": "On-chain mandate id (u64, sequential from 0; exact in JSON numbers far beyond any real count).",
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "mandate_id"
                  ],
                  "type": "object"
                }
              ],
              "type": "array"
            },
            "event": {
              "const": "exhausted",
              "description": "Event name.",
              "type": "string"
            },
            "standard": {
              "const": "nearpay_vault",
              "description": "Always `nearpay_vault`.",
              "type": "string"
            },
            "version": {
              "const": "1.0.0",
              "description": "Always `1.0.0`.",
              "type": "string"
            }
          },
          "required": [
            "standard",
            "version",
            "event",
            "data"
          ],
          "type": "object"
        }
      ]
    },
    "VaultEventRecord": {
      "additionalProperties": {},
      "description": "A valid vault event (contracts-vault §4.1): executor = the vault, outcome `SuccessValue`/`SuccessReceiptId`, block final, schema-valid. Dedupe key `receipt_id:log_index` (at-least-once, INV-4). Envelope: `account_id` null, `livemode` true for the mainnet vault and false for the stand-in, aggregate `vault_mandate` `<vault_contract>#<mandate_id>`.",
      "properties": {
        "block_hash": {
          "description": "Hash of that block.",
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "block_height": {
          "description": "Final block that includes the receipt outcome.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "block_timestamp": {
          "description": "Block time in nanoseconds (decimal string); billing's `created`/`collected_at`.",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "type": "string"
        },
        "event": {
          "$ref": "#/$defs/VaultEvent"
        },
        "log_index": {
          "description": "0-based index of the log line in the receipt's outcome logs.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "receipt_id": {
          "description": "Receipt that logged the event (base58).",
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "tx_hash": {
          "description": "Transaction the receipt belongs to (explorer link).",
          "maxLength": 128,
          "minLength": 8,
          "type": "string"
        },
        "vault_contract": {
          "description": "Executor of the receipt: the configured vault (`NP_VAULT_CONTRACT`; the sandbox stand-in in test mode).",
          "pattern": "^(?=.{2,64}$)(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+$",
          "type": "string"
        }
      },
      "required": [
        "vault_contract",
        "tx_hash",
        "receipt_id",
        "log_index",
        "block_height",
        "block_hash",
        "block_timestamp",
        "event"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "description": "Envelope of `evt.rails.vault.event`.",
  "properties": {
    "account_id": {
      "anyOf": [
        {
          "description": "UUID (RFC 9562).",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Merchant account UUID (null for platform events)."
    },
    "aggregate": {
      "additionalProperties": {},
      "description": "The aggregate that changed.",
      "properties": {
        "id": {
          "description": "Aggregate id (prefixed).",
          "type": "string"
        },
        "type": {
          "description": "Aggregate type.",
          "type": "string"
        },
        "version": {
          "description": "Aggregate version after the change.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "type",
        "id",
        "version"
      ],
      "type": "object"
    },
    "data": {
      "additionalProperties": {},
      "description": "Payload.",
      "properties": {
        "object": {
          "$ref": "#/$defs/VaultEventRecord"
        },
        "previous": {
          "additionalProperties": {},
          "description": "Changed fields with previous values.",
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "object"
      ],
      "type": "object"
    },
    "id": {
      "description": "Event id (UUIDv7); also the NATS `Nats-Msg-Id` for de-duplication.",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
    },
    "livemode": {
      "description": "Mode (null for platform events).",
      "type": [
        "boolean",
        "null"
      ]
    },
    "occurred_at": {
      "description": "When the state change committed.",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    },
    "request": {
      "additionalProperties": {},
      "description": "Request context (copied into public events).",
      "properties": {
        "id": {
          "anyOf": [
            {
              "description": "Request id, also returned in the `X-Request-Id` header.",
              "examples": [
                "req_01jbz9k3m4n5p6q7r8s9t0v1w2"
              ],
              "pattern": "^req_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "API request that caused the change."
        },
        "idempotency_key": {
          "description": "Its Idempotency-Key.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "idempotency_key"
      ],
      "type": "object"
    },
    "subject": {
      "const": "evt.rails.vault.event",
      "description": "Subject.",
      "type": "string"
    },
    "trace": {
      "additionalProperties": {},
      "description": "Trace context.",
      "properties": {
        "traceparent": {
          "description": "W3C traceparent.",
          "type": "string"
        }
      },
      "required": [
        "traceparent"
      ],
      "type": "object"
    }
  },
  "required": [
    "id",
    "occurred_at",
    "account_id",
    "livemode",
    "aggregate",
    "subject",
    "data"
  ],
  "type": "object"
}
