{
  "$defs": {
    "OpsApproval": {
      "additionalProperties": {},
      "description": "A console action waiting for (or decided by) a second operator.",
      "properties": {
        "action": {
          "description": "Action that needs a second approver.",
          "type": "string",
          "x-extensible-enum": [
            "account.suspend",
            "account.reinstate",
            "kill_switch.release"
          ]
        },
        "decided_at": {
          "anyOf": [
            {
              "description": "Unix time in seconds.",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "When it was decided."
        },
        "decided_by": {
          "anyOf": [
            {
              "additionalProperties": {},
              "properties": {
                "id": {
                  "description": "user id (`usr_` + 26 base32 chars).",
                  "examples": [
                    "usr_01jbz9k3m4n5p6q7r8s9t0v1w2"
                  ],
                  "pattern": "^usr_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
                  "type": "string"
                },
                "role": {
                  "description": "Role of a console operator.",
                  "enum": [
                    "ops",
                    "ops_admin"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "id",
                "role"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "description": "Approving or rejecting operator."
        },
        "decision_note": {
          "description": "Note of the deciding operator.",
          "type": [
            "string",
            "null"
          ]
        },
        "expires_at": {
          "description": "A pending request expires at this time.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "description": "ops_approval id (`opa_` + 26 base32 chars).",
          "examples": [
            "opa_01jbz9k3m4n5p6q7r8s9t0v1w2"
          ],
          "pattern": "^opa_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
          "type": "string"
        },
        "object": {
          "const": "ops_approval",
          "description": "Always `ops_approval`.",
          "type": "string"
        },
        "reason": {
          "description": "Requester's reason (audited; never shown to merchants).",
          "type": "string"
        },
        "requested_at": {
          "description": "When it was requested.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "requested_by": {
          "additionalProperties": {},
          "description": "Requesting operator.",
          "properties": {
            "id": {
              "description": "user id (`usr_` + 26 base32 chars).",
              "examples": [
                "usr_01jbz9k3m4n5p6q7r8s9t0v1w2"
              ],
              "pattern": "^usr_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
              "type": "string"
            },
            "role": {
              "description": "Role of a console operator.",
              "enum": [
                "ops",
                "ops_admin"
              ],
              "type": "string"
            }
          },
          "required": [
            "id",
            "role"
          ],
          "type": "object"
        },
        "status": {
          "description": "`approved` means the action was executed in the same transaction.",
          "type": "string",
          "x-extensible-enum": [
            "pending",
            "approved",
            "rejected",
            "expired"
          ]
        },
        "target": {
          "additionalProperties": {},
          "description": "What the action applies to.",
          "properties": {
            "id": {
              "description": "`acct_…` or `ks_…`.",
              "type": "string"
            },
            "type": {
              "description": "Target type.",
              "type": "string",
              "x-extensible-enum": [
                "account",
                "kill_switch"
              ]
            }
          },
          "required": [
            "type",
            "id"
          ],
          "type": "object"
        }
      },
      "required": [
        "id",
        "object",
        "action",
        "target",
        "reason",
        "status",
        "requested_by",
        "requested_at",
        "decided_by",
        "decided_at",
        "decision_note",
        "expires_at"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "description": "Envelope of `evt.sentinel.kill_switch.release_requested`.",
  "properties": {
    "account_id": {
      "anyOf": [
        {
          "description": "UUID (RFC 9562).",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Merchant account UUID (null for platform events)."
    },
    "aggregate": {
      "additionalProperties": {},
      "description": "The aggregate that changed.",
      "properties": {
        "id": {
          "description": "Aggregate id (prefixed).",
          "type": "string"
        },
        "type": {
          "description": "Aggregate type.",
          "type": "string"
        },
        "version": {
          "description": "Aggregate version after the change.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "type",
        "id",
        "version"
      ],
      "type": "object"
    },
    "data": {
      "additionalProperties": {},
      "description": "Payload.",
      "properties": {
        "object": {
          "$ref": "#/$defs/OpsApproval"
        },
        "previous": {
          "additionalProperties": {},
          "description": "Changed fields with previous values.",
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "object"
      ],
      "type": "object"
    },
    "id": {
      "description": "Event id (UUIDv7); also the NATS `Nats-Msg-Id` for de-duplication.",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
    },
    "livemode": {
      "description": "Mode (null for platform events).",
      "type": [
        "boolean",
        "null"
      ]
    },
    "occurred_at": {
      "description": "When the state change committed.",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    },
    "request": {
      "additionalProperties": {},
      "description": "Request context (copied into public events).",
      "properties": {
        "id": {
          "anyOf": [
            {
              "description": "Request id, also returned in the `X-Request-Id` header.",
              "examples": [
                "req_01jbz9k3m4n5p6q7r8s9t0v1w2"
              ],
              "pattern": "^req_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "API request that caused the change."
        },
        "idempotency_key": {
          "description": "Its Idempotency-Key.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "idempotency_key"
      ],
      "type": "object"
    },
    "subject": {
      "const": "evt.sentinel.kill_switch.release_requested",
      "description": "Subject.",
      "type": "string"
    },
    "trace": {
      "additionalProperties": {},
      "description": "Trace context.",
      "properties": {
        "traceparent": {
          "description": "W3C traceparent.",
          "type": "string"
        }
      },
      "required": [
        "traceparent"
      ],
      "type": "object"
    }
  },
  "required": [
    "id",
    "occurred_at",
    "account_id",
    "livemode",
    "aggregate",
    "subject",
    "data"
  ],
  "type": "object"
}
