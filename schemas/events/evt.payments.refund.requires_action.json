            "erc20",
            "nep141",
            "spl",
            "other"
          ]
        }
      },
      "required": [
        "standard",
        "address"
      ],
      "type": "object"
    },
    "TransferIntent": {
      "additionalProperties": {},
      "description": "NEAR Intents `transfer` intent.",
      "properties": {
        "intent": {
          "const": "transfer",
          "description": "Intent kind.",
          "type": "string"
        },
        "memo": {
          "description": "Memo; NearPay puts the binding here.",
          "maxLength": 512,
          "type": "string"
        },
        "receiver_id": {
          "description": "Receiving Intents account.",
          "pattern": "^(?=.{2,64}$)(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+$",
          "type": "string"
        },
        "tokens": {
          "additionalProperties": {
            "description": "Asset amount in base units as a decimal string (no sign, no decimals, ≤ 78 digits).",
            "pattern": "^(0|[1-9][0-9]{0,77})$",
            "type": "string"
          },
          "description": "Asset id → amount in base units.",
          "propertyNames": {
            "description": "NEAR Intents asset id, e.g. `nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1`.",
            "examples": [
              "nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1"
            ],
            "maxLength": 256,
            "pattern": "^(nep141:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+|nep245:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+:[\\x21-\\x7e]{1,128})$",
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "intent",
        "receiver_id",
        "tokens"
      ],
      "type": "object"
    }
  },
