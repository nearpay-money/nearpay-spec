{
  "$defs": {
    "Evidence": {
      "additionalProperties": {},
      "description": "Independent on-chain proof that a settlement reached the merchant (INV-2).",
      "properties": {
        "amount": {
          "description": "Amount received by the recipient, base units.",
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "type": "string"
        },
        "asset_id": {
          "description": "Asset that settled.",
          "examples": [
            "nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1"
          ],
          "maxLength": 256,
          "pattern": "^(nep141:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+|nep245:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+:[\\x21-\\x7e]{1,128})$",
          "type": "string"
        },
        "block_ref": {
          "description": "Block height or hash containing the transaction.",
          "type": [
            "string",
            "null"
          ]
        },
        "chain": {
          "description": "Chain where the settlement happened.",
          "examples": [
            "eip155:8453"
          ],
          "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$",
          "type": "string"
        },
        "explorer_url": {
          "anyOf": [
            {
              "format": "uri",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Block-explorer link for the transaction."
        },
        "finality": {
          "description": "Finality reached when the evidence was accepted.",
          "type": "string",
          "x-extensible-enum": [
            "final",
            "finalized",
            "confirmed"
          ]
        },
        "observed_at": {
          "description": "When NearPay accepted the evidence.",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        "recipient": {
          "description": "Recipient that received the funds (the merchant destination).",
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "source": {
          "description": "Detector that produced the evidence.",
          "type": "string",
          "x-extensible-enum": [
            "watcher",
            "indexer",
            "verifier",
            "provider",
            "operator"
          ]
        },
        "tier": {
          "description": "Verification tier: A = independently verified on chain, B = provider-attested within limits.",
          "type": "string",
          "x-extensible-enum": [
            "A",
            "B"
          ]
        },
        "tx_hash": {
          "description": "Settlement transaction (NEAR receipt / tx hash for Intents).",
          "maxLength": 128,
          "minLength": 8,
          "type": "string"
        }
      },
      "required": [
        "chain",
        "tx_hash",
        "block_ref",
        "recipient",
        "asset_id",
        "amount",
        "finality",
        "tier",
        "source",
        "observed_at",
        "explorer_url"
      ],
      "type": "object"
    },
    "IntentMessage": {
      "additionalProperties": {},
      "description": "Verifier message (`DefusePayload`).",
      "properties": {
        "deadline": {
          "description": "Latest time the Verifier accepts the payload.",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        "intents": {
          "description": "Intents executed atomically.",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/TransferIntent"
              },
              {
                "additionalProperties": {},
                "properties": {
                  "intent": {
                    "description": "Intent kind.",
                    "type": "string"
                  }
                },
                "required": [
                  "intent"
                ],
                "type": "object"
              }
            ],
            "description": "A Verifier intent."
          },
          "minItems": 1,
          "type": "array"
        },
        "nonce": {
          "description": "32-byte nonce (4-byte Verifier salt ‖ 28 random bytes), standard base64.",
          "pattern": "^[A-Za-z0-9+/]{43}=$",
          "type": "string"
        },
        "signer_id": {
          "description": "Intents account that signs (the payer).",
          "pattern": "^(?=.{2,64}$)(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+$",
          "type": "string"
        },
        "verifying_contract": {
          "const": "intents.near",
          "description": "Verifier contract id.",
          "type": "string"
        }
      },
      "required": [
        "signer_id",
        "verifying_contract",
        "deadline",
        "nonce",
        "intents"
      ],
      "type": "object"
    },
    "Refund": {
      "additionalProperties": {},
      "description": "Money returned to a payer, signed by the merchant (non-custodial).",
      "properties": {
        "amount": {
          "description": "Refunded amount, base units of `asset_id`.",
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "type": "string"
        },
        "amount_received": {
          "anyOf": [
            {
              "description": "Asset amount in base units as a decimal string (no sign, no decimals, ≤ 78 digits).",
              "pattern": "^(0|[1-9][0-9]{0,77})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the payer received, base units of `recipient.asset_id` (from evidence)."
        },
        "asset_id": {
          "description": "Settlement asset the amount is in.",
          "examples": [
            "nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1"
          ],
          "maxLength": 256,
          "pattern": "^(nep141:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+|nep245:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+:[\\x21-\\x7e]{1,128})$",
          "type": "string"
        },
        "canceled_at": {
          "anyOf": [
            {
              "description": "Unix time in seconds.",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "When the merchant canceled."
        },
        "created": {
          "description": "Unix time in seconds.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "decimals": {
          "description": "Decimals of `asset_id`.",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Evidence"
            },
            {
              "type": "null"
            }
          ],
          "description": "Payer-side evidence of the leg that refunded the payer (INV-2)."
        },
        "extra_amount_sent": {
          "description": "Settlement-asset amount sent by duplicate legs (signed and sent after another leg had refunded the payer); `0` normally.",
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "type": "string"
        },
        "failure_code": {
          "description": "Why the refund failed (the last leg's code).",
          "type": [
            "string",
            "null"
          ]
        },
        "fee_mode": {
          "description": "`payer_absorbs` (default, `EXACT_INPUT`): the merchant sends `amount`, the payer receives it minus route costs. `merchant_absorbs` (`EXACT_OUTPUT`): the payer receives the equivalent of `amount`; the merchant sends slightly more.",
          "enum": [
            "payer_absorbs",
            "merchant_absorbs"
          ],
          "type": "string"
        },
        "id": {
          "description": "refund id (`re_` + 26 base32 chars).",
          "examples": [
            "re_01jbz9k3m4n5p6q7r8s9t0v1w2"
          ],
          "pattern": "^re_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
          "type": "string"
        },
        "legs": {
          "description": "Legs, newest first.",
          "items": {
            "$ref": "#/$defs/RefundLeg"
          },
          "type": "array"
        },
        "livemode": {
          "description": "`true` for live mode, `false` for test mode.",
          "type": "boolean"
        },
        "metadata": {
          "additionalProperties": {
            "maxLength": 500,
            "type": "string"
          },
          "description": "Up to 50 key/value pairs (key ≤ 40 chars, value ≤ 500 chars) for your own use.",
          "propertyNames": {
            "maxLength": 40,
            "minLength": 1,
            "type": "string"
          },
          "type": "object"
        },
        "method": {
          "description": "`route_quote`: a 1Click route back to the payer's origin chain and asset. `intents_transfer`: a merchant-signed Verifier transfer to the payer's Intents account (refund of an `intents_transfer` payment; no route provider).",
          "type": "string",
          "x-extensible-enum": [
            "route_quote",
            "intents_transfer"
          ]
        },
        "next_action": {
          "anyOf": [
            {
              "$ref": "#/$defs/RefundNextAction"
            },
            {
              "type": "null"
            }
          ],
          "description": "Present in `requires_action` once the current leg is prepared; null while it is being prepared and in every other status."
        },
        "object": {
          "const": "refund",
          "description": "Always `refund`.",
          "type": "string"
        },
        "payment_attempt": {
          "description": "Attempt whose settlement is refunded (the paying attempt, or an overpayment).",
          "examples": [
            "pa_01jbz9k3m4n5p6q7r8s9t0v1w2"
          ],
          "pattern": "^pa_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
          "type": "string"
        },
        "payment_intent": {
          "description": "payment_intent id (`pi_` + 26 base32 chars).",
          "examples": [
            "pi_01jbz9k3m4n5p6q7r8s9t0v1w2"
          ],
          "pattern": "^pi_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "description": "Why the merchant refunds.",
              "type": "string",
              "x-extensible-enum": [
                "requested_by_customer",
                "duplicate",
                "fraudulent",
                "overpayment",
                "other"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "recipient": {
          "$ref": "#/$defs/RefundRecipient"
        },
        "sequence": {
          "description": "Increases with every change; discard webhook objects with a lower sequence.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "source": {
          "description": "What created the refund.",
          "type": "string",
          "x-extensible-enum": [
            "api",
            "dashboard",
            "review_rejection"
          ]
        },
        "status": {
          "description": "Refund status (domain-model §4.4): `requires_action` = waiting for the merchant's signature; `pending` = the merchant's funds were detected and are on their way; `failed` = the provider returned them to the merchant (prepare again to retry).",
          "type": "string",
          "x-extensible-enum": [
            "requires_action",
            "pending",
            "succeeded",
            "failed",
            "canceled"
          ]
        },
        "succeeded_at": {
          "anyOf": [
            {
              "description": "Unix time in seconds.",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "When the payer-side evidence was verified."
        }
      },
      "required": [
        "id",
        "object",
        "created",
        "livemode",
        "status",
        "payment_intent",
        "payment_attempt",
        "amount",
        "asset_id",
        "decimals",
        "fee_mode",
        "reason",
        "method",
        "recipient",
        "next_action",
        "legs",
        "amount_received",
        "evidence",
        "extra_amount_sent",
        "source",
        "failure_code",
        "succeeded_at",
        "canceled_at",
        "sequence",
        "metadata"
      ],
      "type": "object"
    },
    "RefundLeg": {
      "additionalProperties": {},
      "description": "One prepared route or transfer for a refund.",
      "properties": {
        "amount": {
          "description": "What the merchant sends, base units of the settlement asset.",
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "type": "string"
        },
        "amount_out_expected": {
          "anyOf": [
            {
              "description": "Asset amount in base units as a decimal string (no sign, no decimals, ≤ 78 digits).",
              "pattern": "^(0|[1-9][0-9]{0,77})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the payer is expected to receive, base units of the recipient asset (route estimate)."
        },
        "created": {
          "description": "Unix time in seconds.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "deadline": {
          "description": "Sign and send before this time.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "duplicate": {
          "description": "Settled after another leg had already refunded the payer (recorded in `extra_amount_sent`).",
          "type": "boolean"
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Evidence"
            },
            {
              "type": "null"
            }
          ],
          "description": "Payer-side evidence once verified (INV-2)."
        },
        "failure_code": {
          "description": "Why the leg failed, returned or was held.",
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "description": "`route_quote`: a 1Click route back to the payer's origin chain and asset. `intents_transfer`: a merchant-signed Verifier transfer to the payer's Intents account (refund of an `intents_transfer` payment; no route provider).",
          "type": "string",
          "x-extensible-enum": [
            "route_quote",
            "intents_transfer"
          ]
        },
        "number": {
          "description": "Leg number, 1-based; a re-prepared refund gets a new leg.",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "status": {
          "description": "Leg status: `returned` = the provider sent the funds back to the merchant destination; `expired` = the deadline passed without a deposit.",
          "type": "string",
          "x-extensible-enum": [
            "awaiting_signature",
            "submitted",
            "processing",
            "succeeded",
            "returned",
            "failed",
            "expired",
            "held"
          ]
        },
        "submitted_tx": {
          "anyOf": [
            {
              "description": "Transaction hash in the chain's text form.",
              "maxLength": 128,
              "minLength": 8,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Transaction the merchant reported, or the relayed Intents transaction."
        },
        "swap_type": {
          "anyOf": [
            {
              "description": "How the route leg was quoted.",
              "enum": [
                "EXACT_INPUT",
                "EXACT_OUTPUT"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Route legs: how the quote was made; null for Intents transfers."
        }
      },
      "required": [
        "number",
        "status",
        "method",
        "swap_type",
        "amount",
        "amount_out_expected",
        "deadline",
        "submitted_tx",
        "duplicate",
        "evidence",
        "failure_code",
        "created"
      ],
      "type": "object"
    },
    "RefundNextAction": {
      "description": "What the merchant signs for the current leg. Wallets build exactly this (never another recipient or amount; dashboard §1).",
      "oneOf": [
        {
          "$ref": "#/$defs/RefundSignAndSend"
        },
        {
          "$ref": "#/$defs/RefundSignIntent"
        }
      ]
    },
    "RefundRecipient": {
      "additionalProperties": {},
      "description": "Where the refund goes (INV-7: the payer's recorded refund address).",
      "properties": {
        "address": {
          "description": "Payer's refund address (or Intents account).",
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "asset_id": {
          "description": "Asset the payer receives (the asset they paid with).",
          "examples": [
            "nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1"
          ],
          "maxLength": 256,
          "pattern": "^(nep141:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+|nep245:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+:[\\x21-\\x7e]{1,128})$",
          "type": "string"
        },
        "chain": {
          "description": "Chain the payer receives on.",
          "examples": [
            "eip155:8453"
          ],
          "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$",
          "type": "string"
        },
        "overridden": {
          "description": "An owner replaced the recorded refund address (INV-7).",
          "type": "boolean"
        },
        "type": {
          "description": "Address on the origin chain, or a NEAR Intents account.",
          "enum": [
            "origin_chain",
            "intents"
          ],
          "type": "string"
        }
      },
      "required": [
        "address",
        "asset_id",
        "chain",
        "type",
        "overridden"
      ],
      "type": "object"
    },
    "RefundSignAndSend": {
      "additionalProperties": {},
      "description": "Next action: transfer exactly `amount` of `asset_id` from `from` to `to` on `chain`.",
      "properties": {
        "amount": {
          "description": "Exact amount to send, base units.",
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "type": "string"
        },
        "asset_id": {
          "description": "Asset to send (the settlement asset).",
          "examples": [
            "nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1"
          ],
          "maxLength": 256,
          "pattern": "^(nep141:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+|nep245:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+:[\\x21-\\x7e]{1,128})$",
          "type": "string"
        },
        "chain": {
          "description": "Chain to send on (the settlement destination's chain).",
          "examples": [
            "eip155:8453"
          ],
          "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$",
          "type": "string"
        },
        "deadline": {
          "description": "Send before this time; later deposits return to `from`.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "decimals": {
          "description": "Token decimals.",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "display": {
          "description": "Human-readable summary, e.g. `Send 2.000000 USDC on Base to 0xab…`.",
          "type": "string"
        },
        "from": {
          "description": "The settlement destination address; sign with this wallet (refunds of the route go back to it).",
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "memo": {
          "description": "Memo the transfer must carry, if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "symbol": {
          "description": "Token symbol.",
          "type": "string"
        },
        "to": {
          "description": "1Click deposit address of this leg.",
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "token": {
          "$ref": "#/$defs/TokenRef"
        },
        "type": {
          "const": "sign_and_send",
          "description": "Sign and broadcast a transfer on `chain`.",
          "type": "string"
        }
      },
      "required": [
        "type",
        "chain",
        "from",
        "to",
        "asset_id",
        "token",
        "symbol",
        "decimals",
        "amount",
        "memo",
        "deadline",
        "display"
      ],
      "type": "object"
    },
    "RefundSignIntent": {
      "additionalProperties": {},
      "description": "Next action: sign this Verifier transfer with the merchant's Intents account.",
      "properties": {
        "deadline": {
          "description": "The payload's deadline; after it, prepare a new leg.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "display": {
          "description": "Human-readable summary, e.g. `Transfer 2.000000 USDC to payer.near`.",
          "type": "string"
        },
        "message": {
          "$ref": "#/$defs/IntentMessage",
          "description": "Parsed payload, for display and checks; sign `nep413.message` or `payload`."
        },
        "nep413": {
          "additionalProperties": {},
          "description": "Arguments for a NEP-413 `signMessage` call, used verbatim.",
          "properties": {
            "message": {
              "description": "Exact NEP-413 `message` (JSON string of `Nep413IntentMessage`).",
              "minLength": 2,
              "type": "string"
            },
            "nonce": {
              "description": "32-byte nonce (4-byte Verifier salt ‖ 28 random bytes), standard base64.",
              "pattern": "^[A-Za-z0-9+/]{43}=$",
              "type": "string"
            },
            "recipient": {
              "const": "intents.near",
              "description": "NEP-413 recipient.",
              "type": "string"
            }
          },
          "required": [
            "recipient",
            "nonce",
            "message"
          ],
          "type": "object"
        },
        "payload": {
          "description": "Exact string to sign for `erc191` / `raw_ed25519` (JSON of `IntentMessage`, same nonce).",
          "minLength": 2,
          "type": "string"
        },
        "signer_id": {
          "description": "The merchant's Intents account (the settlement destination).",
          "pattern": "^(?=.{2,64}$)(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+$",
          "type": "string"
        },
        "standards": {
          "description": "Signing standards accepted for `signer_id` (`nep413` for NEAR wallets, `erc191` for 0x accounts).",
          "items": {
            "description": "Signing standard supported by NearPay.",
            "enum": [
              "nep413",
              "erc191",
              "raw_ed25519"
