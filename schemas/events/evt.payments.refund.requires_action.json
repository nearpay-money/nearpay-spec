            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "transfer": {
          "additionalProperties": {},
          "description": "The single transfer the payload contains (for the human-readable summary).",
          "properties": {
            "amount": {
              "description": "Amount, base units.",
              "pattern": "^(0|[1-9][0-9]{0,77})$",
              "type": "string"
            },
            "memo": {
              "description": "Binding memo of this leg.",
              "pattern": "^np1:[1-9A-HJ-NP-Za-km-z]{43,44}$",
              "type": "string"
            },
            "receiver_id": {
              "description": "Payer's Intents account (`intents_transfer`) or the 1Click Intents deposit address (`route_quote`).",
              "pattern": "^(?=.{2,64}$)(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+$",
              "type": "string"
            },
            "token": {
              "description": "Asset transferred.",
              "examples": [
                "nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1"
              ],
              "maxLength": 256,
              "pattern": "^(nep141:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+|nep245:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+:[\\x21-\\x7e]{1,128})$",
              "type": "string"
            }
          },
          "required": [
            "receiver_id",
            "token",
            "amount",
            "memo"
          ],
          "type": "object"
        },
        "type": {
          "const": "sign_intent",
          "description": "Sign a NEAR Intents payload; submit it with `submit_tx`.",
          "type": "string"
        }
      },
      "required": [
        "type",
        "signer_id",
        "transfer",
        "standards",
        "nep413",
        "payload",
        "message",
        "deadline",
        "display"
      ],
      "type": "object"
    },
    "TokenRef": {
      "additionalProperties": {},
      "description": "How to transfer an asset on its chain.",
      "properties": {
        "address": {
          "description": "Token contract / mint / NEP-141 account; null for native assets.",
          "type": [
            "string",
            "null"
          ]
