{
  "$defs": {
    "Evidence": {
      "additionalProperties": {},
      "description": "Independent on-chain proof that a settlement reached the merchant (INV-2).",
      "properties": {
        "amount": {
          "description": "Amount received by the recipient, base units.",
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "type": "string"
        },
        "asset_id": {
          "description": "Asset that settled.",
          "examples": [
            "nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1"
          ],
          "maxLength": 256,
          "pattern": "^(nep141:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+|nep245:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+:[\\x21-\\x7e]{1,128})$",
          "type": "string"
        },
        "block_ref": {
          "description": "Block height or hash containing the transaction.",
          "type": [
            "string",
            "null"
          ]
        },
        "chain": {
          "description": "Chain where the settlement happened.",
          "examples": [
            "eip155:8453"
          ],
          "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$",
          "type": "string"
        },
        "explorer_url": {
          "anyOf": [
            {
              "format": "uri",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Block-explorer link for the transaction."
        },
        "finality": {
          "description": "Finality reached when the evidence was accepted.",
          "type": "string",
          "x-extensible-enum": [
            "final",
            "finalized",
            "confirmed"
          ]
        },
        "observed_at": {
          "description": "When NearPay accepted the evidence.",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        "recipient": {
          "description": "Recipient that received the funds (the merchant destination).",
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "source": {
          "description": "Detector that produced the evidence.",
          "type": "string",
          "x-extensible-enum": [
            "watcher",
            "indexer",
            "verifier",
            "provider",
            "operator"
          ]
        },
        "tier": {
          "description": "Verification tier: A = independently verified on chain, B = provider-attested within limits.",
          "type": "string",
          "x-extensible-enum": [
            "A",
            "B"
          ]
        },
        "tx_hash": {
          "description": "Settlement transaction (NEAR receipt / tx hash for Intents).",
          "maxLength": 128,
          "minLength": 8,
          "type": "string"
        }
      },
      "required": [
        "chain",
        "tx_hash",
        "block_ref",
        "recipient",
        "asset_id",
        "amount",
        "finality",
        "tier",
        "source",
        "observed_at",
        "explorer_url"
      ],
      "type": "object"
    },
    "Execution": {
      "additionalProperties": {},
      "description": "A provider run moving value for a payment (rails owns).",
      "properties": {
        "account_id": {
          "description": "account id (`acct_` + 26 base32 chars).",
          "examples": [
            "acct_01jbz9k3m4n5p6q7r8s9t0v1w2"
          ],
          "pattern": "^acct_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
          "type": "string"
        },
        "applied_fee_bps": {
          "description": "Fee bps applied.",
          "maximum": 10000,
          "minimum": 0,
          "type": "integer"
        },
        "created_at": {
          "description": "Created.",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        "deadline": {
          "description": "Execution deadline.",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        "deposit": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionDeposit"
            },
            {
              "type": "null"
            }
          ],
          "description": "`route_quote` deposit instructions."
        },
        "deposit_tx_hashes": {
          "description": "Deposit transactions known so far.",
          "items": {
            "description": "Transaction hash in the chain's text form.",
            "maxLength": 128,
            "minLength": 8,
            "type": "string"
          },
          "type": "array"
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Evidence"
            },
            {
              "type": "null"
            }
          ],
          "description": "Accepted evidence (INV-2)."
        },
        "failure_code": {
          "description": "Failure code.",
          "type": [
            "string",
            "null"
          ]
        },
        "held_reason": {
          "anyOf": [
            {
              "description": "Why held.",
              "type": "string",
              "x-extensible-enum": [
                "evidence_mismatch",
                "evidence_timeout",
                "failed_after_deposit",
                "unknown_status"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "description": "execution id (`ex_` + 26 base32 chars).",
          "examples": [
            "ex_01jbz9k3m4n5p6q7r8s9t0v1w2"
          ],
          "pattern": "^ex_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
          "type": "string"
        },
        "intents_requirement": {
          "anyOf": [
            {
              "$ref": "#/$defs/IntentsRequirement"
            },
            {
              "type": "null"
            }
          ],
          "description": "`intents_transfer` requirement."
        },
        "kind": {
          "description": "What the execution moves value for.",
          "type": "string",
          "x-extensible-enum": [
            "payment",
            "refund"
          ]
        },
        "livemode": {
          "description": "Mode.",
          "type": "boolean"
        },
        "method": {
          "description": "`route_quote`: deposit to a 1Click address from any chain. `intents_transfer`: signed transfer from a NEAR Intents balance.",
          "enum": [
            "route_quote",
            "intents_transfer"
          ],
          "type": "string"
        },
        "origin": {
          "additionalProperties": {},
          "description": "Payer side.",
          "properties": {
            "asset_id": {
              "description": "Origin asset.",
              "examples": [
                "nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1"
              ],
              "maxLength": 256,
              "pattern": "^(nep141:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+|nep245:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+:[\\x21-\\x7e]{1,128})$",
              "type": "string"
            },
            "chain": {
              "description": "Origin chain.",
              "examples": [
                "eip155:8453"
              ],
              "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$",
              "type": "string"
            },
            "refund_to": {
              "description": "Refund address.",
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            "refund_type": {
              "description": "Refund address type.",
              "enum": [
                "origin_chain",
                "intents"
              ],
              "type": "string"
            }
          },
          "required": [
            "asset_id",
            "chain",
            "refund_to",
            "refund_type"
          ],
          "type": "object"
        },
        "price_snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/PriceSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "description": "Route provider.",
          "type": "string",
          "x-extensible-enum": [
            "oneclick",
            "sandbox",
            "direct_intents"
          ]
        },
        "provider_status": {
          "description": "Last provider status (raw).",
          "type": [
            "string",
            "null"
          ]
        },
        "reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionReference"
            },
            {
              "type": "null"
            }
          ],
          "description": "Payments object served (from the create request); null for executions created before Stage 2."
        },
        "refund": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionRefund"
            },
            {
              "type": "null"
            }
          ],
          "description": "Refund legs: `origin` is the merchant side (asset, chain, `refund_to` = the merchant destination) and `settlement` the payer side (`recipient` = the payer's refund address, `tag` 0)."
        },
        "refund_reason": {
          "description": "Provider refund reason.",
          "type": [
            "string",
            "null"
          ]
        },
        "refunded_amount": {
          "anyOf": [
            {
              "description": "Asset amount in base units as a decimal string (no sign, no decimals, ≤ 78 digits).",
              "pattern": "^(0|[1-9][0-9]{0,77})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Amount refunded to the payer."
        },
        "route_class": {
          "description": "Route class (rails §8.1).",
          "type": "string",
          "x-extensible-enum": [
            "same_asset",
            "stable_pair",
            "volatile",
            "intents_transfer"
          ]
        },
        "settled_amount": {
          "anyOf": [
            {
              "description": "Asset amount in base units as a decimal string (no sign, no decimals, ≤ 78 digits).",
              "pattern": "^(0|[1-9][0-9]{0,77})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Amount that reached the recipient."
        },
        "settlement": {
          "additionalProperties": {},
          "description": "Merchant side.",
          "properties": {
            "amount_base": {
              "description": "Settlement amount before the tag.",
              "pattern": "^(0|[1-9][0-9]{0,77})$",
              "type": "string"
            },
            "asset_id": {
              "description": "Settlement asset.",
              "examples": [
                "nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1"
              ],
              "maxLength": 256,
              "pattern": "^(nep141:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+|nep245:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+:[\\x21-\\x7e]{1,128})$",
              "type": "string"
            },
            "chain": {
              "description": "Settlement chain.",
              "examples": [
                "eip155:8453"
              ],
              "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$",
              "type": "string"
            },
            "expected": {
              "description": "Expected output = base + tag.",
              "pattern": "^(0|[1-9][0-9]{0,77})$",
              "type": "string"
            },
            "recipient": {
              "description": "Merchant destination.",
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            "recipient_type": {
              "description": "Recipient type.",
              "enum": [
                "destination_chain",
                "intents"
              ],
              "type": "string"
            },
            "tag": {
              "description": "Amount tag (0 = untagged).",
              "pattern": "^(0|[1-9][0-9]{0,77})$",
              "type": "string"
            }
          },
          "required": [
            "asset_id",
            "amount_base",
            "tag",
            "expected",
            "recipient",
            "recipient_type",
            "chain"
          ],
          "type": "object"
        },
        "state": {
          "description": "Attempt status (mirrors the rails execution, domain-model §4.3).",
          "type": "string",
          "x-extensible-enum": [
            "quoting",
            "awaiting_deposit",
            "deposit_detected",
            "incomplete_deposit",
            "settling",
            "verifying",
            "succeeded",
            "refunded",
            "failed",
            "expired_unpaid",
            "held"
          ]
        },
        "terminal_at": {
          "anyOf": [
            {
              "description": "RFC 3339 UTC timestamp, e.g. `2026-11-05T10:00:00.000Z`.",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "When it reached a terminal state."
        },
        "updated_at": {
          "description": "Updated.",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        "version": {
          "description": "Increments with every applied change (consumers ignore stale versions).",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version",
        "account_id",
        "livemode",
        "kind",
        "method",
        "provider",
        "state",
        "provider_status",
        "route_class",
        "applied_fee_bps",
        "origin",
        "settlement",
        "price_snapshot",
        "deposit",
        "intents_requirement",
        "deposit_tx_hashes",
        "settled_amount",
        "refunded_amount",
        "refund_reason",
        "evidence",
        "failure_code",
        "held_reason",
        "deadline",
        "terminal_at",
        "created_at",
        "updated_at"
      ],
      "type": "object"
    },
    "ExecutionDeposit": {
      "additionalProperties": {},
      "description": "Deposit instructions of a `route_quote` execution.",
      "properties": {
        "address": {
          "description": "Deposit address.",
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "amount_in": {
          "description": "Amount to send.",
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "type": "string"
        },
        "chain": {
          "description": "Origin chain.",
          "examples": [
            "eip155:8453"
          ],
          "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$",
          "type": "string"
        },
        "deadline": {
          "description": "Deposit deadline.",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        "memo": {
          "description": "Memo.",
          "type": [
            "string",
            "null"
          ]
        },
        "min_amount_in": {
          "description": "Provider minimum.",
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "type": "string"
        }
      },
      "required": [
        "address",
        "memo",
        "amount_in",
        "min_amount_in",
        "chain",
        "deadline"
      ],
      "type": "object"
    },
    "ExecutionReference": {
      "additionalProperties": {},
      "description": "The payments object an execution belongs to.",
      "properties": {
        "payment_attempt": {
          "anyOf": [
            {
              "description": "payment_attempt id (`pa_` + 26 base32 chars).",
              "examples": [
                "pa_01jbz9k3m4n5p6q7r8s9t0v1w2"
              ],
              "pattern": "^pa_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Payment attempt (`kind: payment`)."
        },
        "payment_intent": {
          "description": "payment_intent id (`pi_` + 26 base32 chars).",
          "examples": [
            "pi_01jbz9k3m4n5p6q7r8s9t0v1w2"
          ],
          "pattern": "^pi_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
          "type": "string"
        },
        "refund": {
          "anyOf": [
            {
              "description": "refund id (`re_` + 26 base32 chars).",
              "examples": [
                "re_01jbz9k3m4n5p6q7r8s9t0v1w2"
              ],
              "pattern": "^re_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Refund (`kind: refund`)."
        },
        "refund_leg": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Refund leg number (`kind: refund`)."
        }
      },
      "required": [
        "payment_intent",
        "payment_attempt",
        "refund",
        "refund_leg"
      ],
      "type": "object"
    },
    "ExecutionRefund": {
      "additionalProperties": {},
      "description": "Refund-leg details of an execution (`kind: refund`).",
      "properties": {
        "amount": {
          "description": "What the merchant sends, base units of the source (settlement) asset.",
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "type": "string"
        },
        "amount_out_expected": {
          "anyOf": [
            {
              "description": "Asset amount in base units as a decimal string (no sign, no decimals, ≤ 78 digits).",
              "pattern": "^(0|[1-9][0-9]{0,77})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the payer should receive, base units of the recipient asset (quote `amountOut`)."
        },
        "min_amount_out": {
          "anyOf": [
            {
              "description": "Asset amount in base units as a decimal string (no sign, no decimals, ≤ 78 digits).",
              "pattern": "^(0|[1-9][0-9]{0,77})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Quote `minAmountOut` (route legs)."
        },
        "swap_type": {
          "anyOf": [
            {
              "description": "Route quote type.",
              "enum": [
                "EXACT_INPUT",
                "EXACT_OUTPUT"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Route legs only; null for `intents_transfer`."
        },
        "token": {
          "anyOf": [
            {
              "$ref": "#/$defs/TokenContract"
            },
            {
              "type": "null"
            }
          ],
          "description": "How to transfer the source asset on its chain (`sign_and_send` legs); null for Intents sources."
        },
        "transfer": {
          "anyOf": [
            {
              "$ref": "#/$defs/RefundTransfer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Set when the source is an Intents account: the transfer to sign (to the payer, or to the 1Click deposit address)."
        }
      },
      "required": [
        "swap_type",
        "amount",
        "amount_out_expected",
        "min_amount_out",
        "token",
        "transfer"
      ],
      "type": "object"
    },
    "IntentsRequirement": {
      "additionalProperties": {},
      "description": "What a payer must sign: transfer(pay_to, amount) and transfer(fee_to, fee_amount), both with memo = binding.",
      "properties": {
        "amount": {
          "description": "Amount the merchant receives, base units.",
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "type": "string"
        },
        "binding": {
          "description": "Memo that both transfers must carry.",
          "pattern": "^np1:[1-9A-HJ-NP-Za-km-z]{43,44}$",
          "type": "string"
        },
        "deadline": {
          "description": "Latest acceptable payload deadline.",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        "fee_amount": {
          "description": "NearPay fee, base units, in the same asset.",
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "type": "string"
        },
        "fee_to": {
          "description": "NearPay treasury Intents account.",
          "pattern": "^(?=.{2,64}$)(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+$",
          "type": "string"
        },
        "pay_to": {
          "description": "Merchant Intents account that receives the payment.",
          "pattern": "^(?=.{2,64}$)(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+$",
          "type": "string"
        },
        "token": {
          "description": "Asset to transfer (equals the settlement asset).",
          "examples": [
            "nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1"
          ],
          "maxLength": 256,
          "pattern": "^(nep141:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+|nep245:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+:[\\x21-\\x7e]{1,128})$",
          "type": "string"
        }
      },
      "required": [
        "pay_to",
        "token",
        "amount",
        "fee_to",
        "fee_amount",
        "binding",
        "deadline"
      ],
      "type": "object"
    },
    "PriceRate": {
      "additionalProperties": {},
      "description": "A price or FX rate with its source and timestamps (INV-5: exact rational).",
      "properties": {
        "as_of": {
          "description": "When the source says the value applies (ECB: publication time of the reference day; feeds: their update time).",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        "base": {
          "anyOf": [
            {
              "description": "ISO 4217 currency code, lower-case (e.g. `usd`).",
              "pattern": "^[a-z]{3}$",
              "type": "string"
            },
            {
              "description": "NEAR Intents asset id, e.g. `nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1`.",
              "examples": [
                "nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1"
              ],
              "maxLength": 256,
              "pattern": "^(nep141:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+|nep245:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+:[\\x21-\\x7e]{1,128})$",
              "type": "string"
            }
          ],
          "description": "What is priced: a currency code or an asset id."
        },
        "decimal": {
          "description": "The rate as a decimal string rounded half-even to ≤ 18 places; display only, never for arithmetic.",
          "pattern": "^(0|[1-9][0-9]{0,59})(\\.[0-9]{1,18})?$",
          "type": "string"
        },
        "fetched_at": {
          "description": "When rails read it.",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        "kind": {
          "description": "`fx`: fiat exchange rate; `price`: token price.",
          "type": "string",
          "x-extensible-enum": [
            "fx",
            "price"
          ]
        },
        "quote": {
          "description": "Currency the value is expressed in (`usd`).",
          "pattern": "^[a-z]{3}$",
          "type": "string"
        },
        "role": {
          "description": "`primary`/`secondary`: the two token prices the dual-source check compares (rails §8.2); `reference`: a fiat FX reference rate.",
          "type": "string",
          "x-extensible-enum": [
            "primary",
            "secondary",
            "reference"
          ]
        },
        "source": {
          "description": "Where a rate comes from: `oneclick` (1Click `/v0/tokens`, primary token price), `coingecko` (keyless public feed, secondary token price), `ecb` (ECB euro reference rates, fiat FX), `sandbox` (test-mode token prices), `fixed` (test-mode FX table, and `usd`→`usd`).",
          "type": "string",
          "x-extensible-enum": [
            "oneclick",
            "coingecko",
            "ecb",
            "sandbox",
            "fixed"
          ]
        },
        "valid_until": {
          "anyOf": [
            {
              "description": "RFC 3339 UTC timestamp, e.g. `2026-11-05T10:00:00.000Z`.",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "After this instant rails no longer uses the rate (staleness bound, rails §8.2); null = no bound (`fixed`)."
        },
        "value": {
          "$ref": "#/$defs/Ratio",
          "description": "Quote major units per one major unit of `base`."
        }
      },
      "required": [
        "base",
        "quote",
        "kind",
        "role",
        "source",
        "value",
        "decimal",
        "as_of",
        "fetched_at",
        "valid_until"
      ],
      "type": "object"
    },
    "PriceSnapshot": {
      "additionalProperties": {},
      "description": "Prices used to compute the settlement amount (INV-6).",
      "properties": {
        "as_of": {
          "description": "When prices were read.",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        "currency": {
          "anyOf": [
            {
              "description": "ISO 4217 currency code, lower-case (e.g. `usd`).",
              "pattern": "^[a-z]{3}$",
              "type": "string"
            },
            {
              "const": "asset",
              "type": "string"
            }
          ],
          "description": "Pricing currency of the payment (spec 0.2.0; rails 0.2.0+ always sends it): an ISO code, or `asset`."
        },
        "fx": {
          "description": "FX rate pricing currency → USD (decimal string), null for USD.",
          "type": [
            "string",
            "null"
          ]
        },
        "par": {
          "description": "Settled at par (USD stablecoin, depeg guard passed).",
          "type": "boolean"
        },
        "par_currency": {
          "anyOf": [
            {
              "description": "ISO 4217 currency code, lower-case (e.g. `usd`).",
              "pattern": "^[a-z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Currency the settlement asset was taken at par with (`usd` for USD stablecoins), or null (spec 0.2.0)."
        },
        "primary_usd": {
          "description": "Primary USD price of the settlement asset (decimal string).",
          "type": [
            "string",
            "null"
          ]
        },
        "rates": {
          "description": "Every rate used, exact, with source, `as_of` and `valid_until` (spec 0.2.0; rails 0.2.0+ always sends it): the FX rate of a non-USD currency and the primary + secondary prices of a non-par asset.",
          "items": {
            "$ref": "#/$defs/PriceRate"
          },
          "type": "array"
        },
        "secondary_usd": {
          "description": "Secondary USD price (decimal string).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "primary_usd",
        "secondary_usd",
        "fx",
        "par",
        "as_of"
      ],
      "type": "object"
    },
    "Ratio": {
      "additionalProperties": {},
      "description": "An exact rational number `num / den` (integer strings, never a float).",
      "properties": {
        "den": {
          "description": "Denominator (positive integer string).",
          "pattern": "^[1-9][0-9]{0,77}$",
          "type": "string"
        },
        "num": {
          "description": "Numerator (integer string).",
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "type": "string"
        }
      },
      "required": [
        "num",
        "den"
      ],
      "type": "object"
    },
    "RefundTransfer": {
      "additionalProperties": {},
      "description": "What a merchant signs for a refund leg from an Intents account: exactly one transfer, memo = binding.",
      "properties": {
        "amount": {
          "description": "Amount, base units.",
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "type": "string"
        },
        "deadline": {
          "description": "Latest acceptable payload deadline.",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        "memo": {
          "description": "Binding memo the transfer must carry (agentpay matches it; the indexer attributes by it).",
          "pattern": "^np1:[1-9A-HJ-NP-Za-km-z]{43,44}$",
          "type": "string"
        },
        "receiver_id": {
          "description": "Payer Intents account (`intents_transfer` leg) or the 1Click INTENTS deposit address (`route_quote` leg).",
          "pattern": "^(?=.{2,64}$)(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+$",
          "type": "string"
        },
        "signer_id": {
          "description": "Merchant Intents account (the settlement destination) that signs.",
          "pattern": "^(?=.{2,64}$)(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+$",
          "type": "string"
        },
        "token": {
          "description": "Asset transferred (the settlement asset).",
          "examples": [
            "nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1"
          ],
          "maxLength": 256,
          "pattern": "^(nep141:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+|nep245:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+:[\\x21-\\x7e]{1,128})$",
          "type": "string"
        }
      },
      "required": [
        "signer_id",
        "receiver_id",
        "token",
        "amount",
        "memo",
        "deadline"
      ],
      "type": "object"
    },
    "TokenContract": {
      "additionalProperties": {},
      "description": "How to transfer an asset on its chain (wallet path).",
      "properties": {
        "address": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Contract address (EVM `0x…`) or token account (NEAR); null for `native`."
        },
        "standard": {
          "description": "`erc20`: ERC-20 contract on an EVM chain; `native`: the chain's native coin (no contract); `nep141`: NEP-141 token on NEAR; `spl`: SPL mint on Solana; `other`: no wallet transfer recipe (manual path).",
          "type": "string",
          "x-extensible-enum": [
            "erc20",
            "native",
            "nep141",
            "spl",
            "other"
          ]
        }
      },
      "required": [
        "standard",
        "address"
      ],
      "type": "object"
    }
  },
