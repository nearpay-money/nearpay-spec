{
  "$defs": {
    "EventReviewOpened": {
      "additionalProperties": {},
      "description": "`review.opened` event.",
      "properties": {
        "api_version": {
          "description": "API version the payload is rendered in.",
          "enum": [
            "2026-11-01"
          ],
          "type": "string"
        },
        "created": {
          "description": "Unix time in seconds.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "data": {
          "additionalProperties": {},
          "description": "Event data.",
          "properties": {
            "object": {
              "$ref": "#/$defs/PublicReview"
            },
            "previous_attributes": {
              "additionalProperties": {},
              "description": "Changed fields with their previous values (update events).",
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            }
          },
          "required": [
            "object"
          ],
          "type": "object"
        },
        "id": {
          "description": "event id (`evt_` + 26 base32 chars).",
          "examples": [
            "evt_01jbz9k3m4n5p6q7r8s9t0v1w2"
          ],
          "pattern": "^evt_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
          "type": "string"
        },
        "livemode": {
          "description": "`true` for live mode, `false` for test mode.",
          "type": "boolean"
        },
        "object": {
          "const": "event",
          "description": "Always `event`.",
          "type": "string"
        },
        "request": {
          "additionalProperties": {},
          "description": "Request that caused the event.",
          "properties": {
            "id": {
              "anyOf": [
                {
                  "description": "request id (`req_` + 26 base32 chars).",
                  "examples": [
                    "req_01jbz9k3m4n5p6q7r8s9t0v1w2"
                  ],
                  "pattern": "^req_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "API request that caused the event, if any."
            },
            "idempotency_key": {
              "description": "Idempotency-Key of that request, if any.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "idempotency_key"
          ],
          "type": "object"
        },
        "type": {
          "const": "review.opened",
          "description": "Event type.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "object",
        "type",
        "api_version",
        "created",
        "livemode",
        "data",
        "request"
      ],
      "type": "object"
    },
    "PublicReview": {
      "additionalProperties": {},
      "description": "A compliance review of a payment or destination (the payment stands).",
      "properties": {
        "closed_at": {
          "anyOf": [
            {
              "description": "Unix time in seconds.",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "When the review closed."
        },
        "created": {
          "description": "When the review opened.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "description": "compliance_case id (`case_` + 26 base32 chars).",
          "examples": [
            "case_01jbz9k3m4n5p6q7r8s9t0v1w2"
          ],
          "pattern": "^case_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
          "type": "string"
        },
        "livemode": {
          "description": "`true` for live mode, `false` for test mode.",
          "type": "boolean"
        },
        "object": {
          "const": "review",
          "description": "Always `review`.",
          "type": "string"
        },
        "reason": {
          "description": "Why the review opened.",
          "type": "string",
          "x-extensible-enum": [
            "post_screen_hit",
            "held_execution",
            "audit_mismatch",
            "screening_hit"
          ]
        },
        "status": {
          "description": "Review status.",
          "type": "string",
          "x-extensible-enum": [
            "open",
            "closed"
          ]
        },
        "subject": {
          "additionalProperties": {},
          "description": "What is under review.",
          "properties": {
            "id": {
              "description": "Reviewed object id (`pi_…`, `ap_…` or `sd_…`).",
              "type": "string"
            },
            "type": {
              "description": "Reviewed object type.",
              "type": "string",
              "x-extensible-enum": [
                "payment_intent",
                "agent_payment",
                "settlement_destination"
              ]
            }
          },
          "required": [
            "type",
            "id"
          ],
          "type": "object"
        }
      },
      "required": [
        "id",
        "object",
        "created",
        "livemode",
        "subject",
        "reason",
        "status",
        "closed_at"
      ],
      "type": "object"
    }
  },
  "$ref": "#/$defs/EventReviewOpened",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
