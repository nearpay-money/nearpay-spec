{
  "$defs": {
    "AgentPayment": {
      "additionalProperties": {},
      "description": "A payer-signed NEAR Intents payment relayed by NearPay.",
      "properties": {
        "amount": {
          "description": "Amount to the merchant, base units.",
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "type": "string"
        },
        "asset_id": {
          "description": "Asset.",
          "examples": [
            "nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1"
          ],
          "maxLength": 256,
          "pattern": "^(nep141:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+|nep245:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+:[\\x21-\\x7e]{1,128})$",
          "type": "string"
        },
        "binding": {
          "description": "Binding memo `np1:` + base58(sha256(…)) tying a signed transfer to one requirement.",
          "pattern": "^np1:[1-9A-HJ-NP-Za-km-z]{43,44}$",
          "type": "string"
        },
        "block_height": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Block of the transaction."
        },
        "checkout_session": {
          "anyOf": [
            {
              "description": "checkout_session id (`cs_` + 26 base32 chars).",
              "examples": [
                "cs_01jbz9k3m4n5p6q7r8s9t0v1w2"
              ],
              "pattern": "^cs_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Checkout session paid (checkout kind)."
        },
        "created": {
          "description": "Unix time in seconds.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "error_reason": {
          "description": "Why it failed.",
          "type": [
            "string",
            "null"
          ]
        },
        "fee_amount": {
          "description": "NearPay fee, base units.",
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "type": "string"
        },
        "id": {
          "description": "agent_payment id (`ap_` + 26 base32 chars).",
          "examples": [
            "ap_01jbz9k3m4n5p6q7r8s9t0v1w2"
          ],
          "pattern": "^ap_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
          "type": "string"
        },
        "kind": {
          "description": "What the signed payload paid for.",
          "type": "string",
          "x-extensible-enum": [
            "x402",
            "checkout",
            "refund"
          ]
        },
        "livemode": {
          "description": "`true` for live mode, `false` for test mode.",
          "type": "boolean"
        },
        "object": {
          "const": "agent_payment",
          "description": "Always `agent_payment`.",
          "type": "string"
        },
        "pay_to": {
          "description": "Merchant Intents account.",
          "pattern": "^(?=.{2,64}$)(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+$",
          "type": "string"
        },
        "payer": {
          "description": "Payer Intents account (signer).",
          "pattern": "^(?=.{2,64}$)(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+$",
          "type": "string"
        },
        "resource_url": {
          "anyOf": [
            {
              "format": "uri",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Paid resource (x402)."
        },
        "sequence": {
          "description": "Increases with every change; discard webhook objects with a lower sequence. Servers MUST send it (optional in the 0.1.x schema only so readers built on 0.1.4 stay compatible).",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "settled_at": {
          "anyOf": [
            {
              "description": "Unix time in seconds.",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "When it settled (final)."
        },
        "status": {
          "description": "Relay status.",
          "type": "string",
          "x-extensible-enum": [
            "verified",
            "queued",
            "submitted",
            "settled",
            "failed"
          ]
        },
        "tx_hash": {
          "anyOf": [
            {
              "description": "Transaction hash in the chain's text form.",
              "maxLength": 128,
              "minLength": 8,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "NEAR transaction that executed the payload."
        }
      },
      "required": [
        "id",
        "object",
        "created",
        "livemode",
        "kind",
        "status",
        "payer",
        "pay_to",
        "asset_id",
        "amount",
        "fee_amount",
        "binding",
        "resource_url",
        "checkout_session",
        "tx_hash",
        "block_height",
        "error_reason",
        "settled_at"
      ],
      "type": "object"
    },
    "EventAgentPaymentSettled": {
      "additionalProperties": {},
      "description": "`agent_payment.settled` event.",
      "properties": {
        "api_version": {
          "description": "API version the payload is rendered in.",
          "enum": [
            "2026-11-01"
          ],
          "type": "string"
        },
        "created": {
          "description": "Unix time in seconds.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "data": {
          "additionalProperties": {},
          "description": "Event data.",
          "properties": {
            "object": {
              "$ref": "#/$defs/AgentPayment"
            },
            "previous_attributes": {
              "additionalProperties": {},
              "description": "Changed fields with their previous values (update events).",
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            }
          },
          "required": [
            "object"
          ],
          "type": "object"
        },
        "id": {
          "description": "event id (`evt_` + 26 base32 chars).",
          "examples": [
            "evt_01jbz9k3m4n5p6q7r8s9t0v1w2"
          ],
          "pattern": "^evt_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
          "type": "string"
        },
        "livemode": {
          "description": "`true` for live mode, `false` for test mode.",
          "type": "boolean"
        },
        "object": {
          "const": "event",
          "description": "Always `event`.",
          "type": "string"
        },
        "request": {
          "additionalProperties": {},
          "description": "Request that caused the event.",
          "properties": {
            "id": {
              "anyOf": [
                {
                  "description": "request id (`req_` + 26 base32 chars).",
                  "examples": [
                    "req_01jbz9k3m4n5p6q7r8s9t0v1w2"
                  ],
                  "pattern": "^req_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "API request that caused the event, if any."
            },
            "idempotency_key": {
              "description": "Idempotency-Key of that request, if any.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "idempotency_key"
          ],
          "type": "object"
        },
        "type": {
          "const": "agent_payment.settled",
          "description": "Event type.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "object",
        "type",
        "api_version",
        "created",
        "livemode",
        "data",
        "request"
      ],
      "type": "object"
    }
  },
  "$ref": "#/$defs/EventAgentPaymentSettled",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
