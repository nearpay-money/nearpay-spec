{
  "$defs": {
    "DestinationSnapshot": {
      "additionalProperties": {},
      "description": "Settlement destination as snapshotted at creation (INV-6).",
      "properties": {
        "address": {
          "description": "Settlement address or Intents account.",
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "asset_id": {
          "description": "Settlement asset.",
          "examples": [
            "nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1"
          ],
          "maxLength": 256,
          "pattern": "^(nep141:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+|nep245:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+:[\\x21-\\x7e]{1,128})$",
          "type": "string"
        },
        "chain": {
          "description": "Settlement chain.",
          "examples": [
            "eip155:8453"
          ],
          "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$",
          "type": "string"
        },
        "fingerprint": {
          "anyOf": [
            {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{4}-[0-9A-HJKMNP-TV-Z]{4}-[0-9A-HJKMNP-TV-Z]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Fingerprint of the destination as shown at checkout (CR-15-04, spec 0.2.0); optional so older servers stay valid."
        },
        "settlement_destination": {
          "description": "settlement_destination id (`sd_` + 26 base32 chars).",
          "examples": [
            "sd_01jbz9k3m4n5p6q7r8s9t0v1w2"
          ],
          "pattern": "^sd_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
          "type": "string"
        },
        "type": {
          "description": "Where funds settle: an address on a chain, or a NEAR Intents account.",
          "enum": [
            "chain_address",
            "intents_account"
          ],
          "type": "string"
        }
      },
      "required": [
        "settlement_destination",
        "asset_id",
        "type",
        "chain",
        "address"
      ],
      "type": "object"
    },
    "EventPaymentIntentSucceeded": {
      "additionalProperties": {},
      "description": "`payment_intent.succeeded` event.",
      "properties": {
        "api_version": {
          "description": "API version the payload is rendered in.",
          "enum": [
            "2026-11-01"
          ],
          "type": "string"
        },
        "created": {
          "description": "Unix time in seconds.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "data": {
          "additionalProperties": {},
          "description": "Event data.",
          "properties": {
            "object": {
              "$ref": "#/$defs/PaymentIntent"
            },
            "previous_attributes": {
              "additionalProperties": {},
              "description": "Changed fields with their previous values (update events).",
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            }
          },
          "required": [
            "object"
          ],
          "type": "object"
        },
        "id": {
          "description": "event id (`evt_` + 26 base32 chars).",
          "examples": [
            "evt_01jbz9k3m4n5p6q7r8s9t0v1w2"
          ],
          "pattern": "^evt_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
          "type": "string"
        },
        "livemode": {
          "description": "`true` for live mode, `false` for test mode.",
          "type": "boolean"
        },
        "object": {
          "const": "event",
          "description": "Always `event`.",
          "type": "string"
        },
        "request": {
          "additionalProperties": {},
          "description": "Request that caused the event.",
          "properties": {
            "id": {
              "anyOf": [
                {
                  "description": "request id (`req_` + 26 base32 chars).",
                  "examples": [
                    "req_01jbz9k3m4n5p6q7r8s9t0v1w2"
                  ],
                  "pattern": "^req_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "API request that caused the event, if any."
            },
            "idempotency_key": {
              "description": "Idempotency-Key of that request, if any.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "idempotency_key"
          ],
          "type": "object"
        },
        "type": {
          "const": "payment_intent.succeeded",
          "description": "Event type.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "object",
        "type",
        "api_version",
        "created",
        "livemode",
        "data",
        "request"
      ],
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": {},
      "description": "Independent on-chain proof that a settlement reached the merchant (INV-2).",
      "properties": {
        "amount": {
          "description": "Amount received by the recipient, base units.",
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "type": "string"
        },
        "asset_id": {
          "description": "Asset that settled.",
          "examples": [
            "nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1"
          ],
          "maxLength": 256,
          "pattern": "^(nep141:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+|nep245:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+:[\\x21-\\x7e]{1,128})$",
          "type": "string"
        },
        "block_ref": {
          "description": "Block height or hash containing the transaction.",
          "type": [
            "string",
            "null"
          ]
        },
        "chain": {
          "description": "Chain where the settlement happened.",
          "examples": [
            "eip155:8453"
          ],
          "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$",
          "type": "string"
        },
        "explorer_url": {
          "anyOf": [
            {
              "format": "uri",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Block-explorer link for the transaction."
        },
        "finality": {
          "description": "Finality reached when the evidence was accepted.",
          "type": "string",
          "x-extensible-enum": [
            "final",
            "finalized",
            "confirmed"
          ]
        },
        "observed_at": {
          "description": "When NearPay accepted the evidence.",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        "recipient": {
          "description": "Recipient that received the funds (the merchant destination).",
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "source": {
          "description": "Detector that produced the evidence.",
          "type": "string",
          "x-extensible-enum": [
            "watcher",
            "indexer",
            "verifier",
            "provider",
            "operator"
          ]
        },
        "tier": {
          "description": "Verification tier: A = independently verified on chain, B = provider-attested within limits.",
          "type": "string",
          "x-extensible-enum": [
            "A",
            "B"
          ]
        },
        "tx_hash": {
          "description": "Settlement transaction (NEAR receipt / tx hash for Intents).",
          "maxLength": 128,
          "minLength": 8,
          "type": "string"
        }
      },
      "required": [
        "chain",
        "tx_hash",
        "block_ref",
        "recipient",
        "asset_id",
        "amount",
        "finality",
        "tier",
        "source",
        "observed_at",
        "explorer_url"
      ],
      "type": "object"
    },
    "FeeSummary": {
      "additionalProperties": {},
      "description": "Fee snapshot of a payment (INV-6).",
      "properties": {
        "bearer": {
          "description": "Who bears the fee.",
          "enum": [
            "payer",
            "merchant"
          ],
          "type": "string"
        },
        "total_bps": {
          "description": "NearPay fee applied to this payment's route, in basis points.",
          "maximum": 10000,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "bearer",
        "total_bps"
      ],
      "type": "object"
    },
    "PaymentAttemptSummary": {
      "additionalProperties": {},
      "description": "One payment attempt of an intent, as merchants see it.",
      "properties": {
        "created": {
          "description": "Unix time in seconds.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "deadline": {
          "anyOf": [
            {
              "description": "Unix time in seconds.",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Deposit deadline."
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Evidence"
            },
            {
              "type": "null"
            }
          ],
          "description": "Settlement evidence, once verified."
        },
        "failure_code": {
          "description": "Why the attempt failed, refunded or was held.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "payment_attempt id (`pa_` + 26 base32 chars).",
          "examples": [
            "pa_01jbz9k3m4n5p6q7r8s9t0v1w2"
          ],
          "pattern": "^pa_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
          "type": "string"
        },
        "is_overpayment": {
          "description": "Settled after another attempt already paid the intent.",
          "type": "boolean"
        },
        "method": {
          "description": "`route_quote`: deposit to a 1Click address from any chain. `intents_transfer`: signed transfer from a NEAR Intents balance.",
          "enum": [
            "route_quote",
            "intents_transfer"
          ],
          "type": "string"
        },
        "object": {
          "const": "payment_attempt",
          "description": "Always `payment_attempt`.",
          "type": "string"
        },
        "origin_amount": {
          "anyOf": [
            {
              "description": "Asset amount in base units as a decimal string (no sign, no decimals, ≤ 78 digits).",
              "pattern": "^(0|[1-9][0-9]{0,77})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the payer actually sent, base units of `origin_asset_id` (rails `deposited_amount`); null until a deposit is detected. Spec 0.2.1."
        },
        "origin_asset_id": {
          "description": "Asset the payer pays with.",
          "examples": [
            "nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1"
          ],
          "maxLength": 256,
          "pattern": "^(nep141:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+|nep245:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+:[\\x21-\\x7e]{1,128})$",
          "type": "string"
        },
        "origin_chain": {
          "description": "Chain the payer pays from.",
          "examples": [
            "eip155:8453"
          ],
          "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$",
          "type": "string"
        },
        "refund_to": {
          "anyOf": [
            {
              "description": "Address in the chain's canonical text form.",
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The payer's own address as given at checkout, where refunds go (INV-7): the refund address on the origin chain (`route_quote`; the connected wallet or a typed address, which may differ from the wallet that sent the deposit) or the payer's Intents account (`intents_transfer`). Spec 0.2.1."
        },
        "settled_amount": {
          "anyOf": [
            {
              "description": "Asset amount in base units as a decimal string (no sign, no decimals, ≤ 78 digits).",
              "pattern": "^(0|[1-9][0-9]{0,77})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Amount that settled, base units."
        },
        "settlement_amount": {
          "anyOf": [
            {
              "description": "Asset amount in base units as a decimal string (no sign, no decimals, ≤ 78 digits).",
              "pattern": "^(0|[1-9][0-9]{0,77})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Expected settlement including the amount tag, base units."
        },
        "status": {
          "description": "Attempt status (mirrors the rails execution, domain-model §4.3).",
          "type": "string",
          "x-extensible-enum": [
            "quoting",
            "awaiting_deposit",
            "deposit_detected",
            "incomplete_deposit",
            "settling",
            "verifying",
            "succeeded",
            "refunded",
            "failed",
            "expired_unpaid",
            "held"
          ]
        }
      },
      "required": [
        "id",
        "object",
        "created",
        "status",
        "method",
        "origin_asset_id",
        "origin_chain",
        "settlement_amount",
        "settled_amount",
        "deadline",
        "is_overpayment",
        "failure_code",
        "evidence"
      ],
      "type": "object"
    },
    "PaymentIntent": {
      "additionalProperties": {},
      "description": "One payment the merchant expects (FR-PAY-01).",
      "properties": {
        "amount": {
          "anyOf": [
            {
              "description": "Fiat amount in minor units (e.g. cents), integer.",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "description": "Asset amount in base units as a decimal string (no sign, no decimals, ≤ 78 digits).",
              "pattern": "^(0|[1-9][0-9]{0,77})$",
              "type": "string"
            }
          ],
          "description": "Fiat: integer minor units. Asset: base units as a decimal string."
        },
        "amount_refund_pending": {
          "description": "Amount of refunds in `requires_action` or `pending`, base units of the settlement asset (Stage 2).",
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "type": "string"
        },
        "amount_refunded": {
          "description": "Refunded amount, base units of the settlement asset.",
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "type": "string"
        },
        "amount_settled": {
          "description": "Settled amount, base units of the settlement asset.",
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "type": "string"
        },
        "asset_id": {
          "anyOf": [
            {
              "description": "NEAR Intents asset id, e.g. `nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1`.",
              "examples": [
                "nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1"
              ],
              "maxLength": 256,
              "pattern": "^(nep141:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+|nep245:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+:[\\x21-\\x7e]{1,128})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Pricing asset when `currency` is `asset`."
        },
        "attempts": {
          "description": "Attempts, newest first.",
          "items": {
            "$ref": "#/$defs/PaymentAttemptSummary"
          },
          "type": "array"
        },
        "canceled_at": {
          "anyOf": [
            {
              "description": "Unix time in seconds.",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "When the intent was canceled."
        },
        "cancellation_reason": {
          "description": "Reason given on cancel.",
          "type": [
            "string",
            "null"
          ]
        },
        "checkout_session": {
          "anyOf": [
            {
              "description": "checkout_session id (`cs_` + 26 base32 chars).",
              "examples": [
                "cs_01jbz9k3m4n5p6q7r8s9t0v1w2"
              ],
              "pattern": "^cs_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Checkout session that owns the intent."
        },
        "created": {
          "description": "Unix time in seconds.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "currency": {
          "anyOf": [
            {
              "description": "ISO 4217 currency code, lower-case (e.g. `usd`).",
              "pattern": "^[a-z]{3}$",
              "type": "string"
            },
            {
              "const": "asset",
              "type": "string"
            }
          ],
          "description": "ISO 4217 code for fiat pricing, or `asset` when priced in an asset (then `asset_id` is set)."
        },
        "customer": {
          "anyOf": [
            {
              "description": "customer id (`cus_` + 26 base32 chars).",
              "examples": [
                "cus_01jbz9k3m4n5p6q7r8s9t0v1w2"
              ],
              "pattern": "^cus_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Customer the intent belongs to (Stage 2)."
        },
        "description": {
          "description": "Description shown to the payer.",
          "type": [
            "string",
            "null"
          ]
        },
        "destination": {
          "$ref": "#/$defs/DestinationSnapshot"
        },
        "fee": {
          "$ref": "#/$defs/FeeSummary"
        },
        "id": {
          "description": "payment_intent id (`pi_` + 26 base32 chars).",
          "examples": [
            "pi_01jbz9k3m4n5p6q7r8s9t0v1w2"
          ],
          "pattern": "^pi_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
          "type": "string"
        },
        "late": {
          "description": "Settled after its checkout session expired (INV-3).",
          "type": "boolean"
        },
        "livemode": {
          "description": "`true` for live mode, `false` for test mode.",
          "type": "boolean"
        },
        "metadata": {
          "additionalProperties": {
            "maxLength": 500,
            "type": "string"
          },
          "description": "Up to 50 key/value pairs (key ≤ 40 chars, value ≤ 500 chars) for your own use.",
          "propertyNames": {
            "maxLength": 40,
            "minLength": 1,
            "type": "string"
          },
          "type": "object"
        },
        "object": {
          "const": "payment_intent",
          "description": "Always `payment_intent`.",
          "type": "string"
        },
        "overpayments": {
          "description": "Settlements beyond the one that paid the intent (refund recommended).",
          "items": {
            "additionalProperties": {},
            "description": "An extra settlement.",
            "properties": {
              "amount": {
                "description": "Extra amount that settled, base units.",
                "pattern": "^(0|[1-9][0-9]{0,77})$",
                "type": "string"
              },
              "attempt": {
                "description": "payment_attempt id (`pa_` + 26 base32 chars).",
                "examples": [
                  "pa_01jbz9k3m4n5p6q7r8s9t0v1w2"
                ],
                "pattern": "^pa_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
                "type": "string"
              },
              "reason": {
                "description": "Why it counts as an overpayment.",
                "type": "string",
                "x-extensible-enum": [
                  "duplicate",
                  "after_cancel",
                  "after_expiry"
                ]
              }
            },
            "required": [
              "attempt",
              "amount",
              "reason"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "payment_link": {
          "anyOf": [
            {
              "description": "payment_link id (`plink_` + 26 base32 chars).",
              "examples": [
                "plink_01jbz9k3m4n5p6q7r8s9t0v1w2"
              ],
              "pattern": "^plink_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Payment link that created the intent (`source: payment_link`)."
        },
        "refunds": {
          "description": "Refunds of this intent, newest first (Stage 2).",
          "items": {
            "description": "refund id (`re_` + 26 base32 chars).",
            "examples": [
              "re_01jbz9k3m4n5p6q7r8s9t0v1w2"
            ],
            "pattern": "^re_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
            "type": "string"
          },
          "type": "array"
        },
        "review_decision": {
          "anyOf": [
            {
              "additionalProperties": {},
              "properties": {
                "decided_at": {
                  "description": "When the decision was recorded.",
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "decision": {
                  "description": "Merchant decision.",
                  "enum": [
                    "accept",
                    "reject"
                  ],
                  "type": "string"
                },
                "refund": {
                  "anyOf": [
                    {
                      "description": "refund id (`re_` + 26 base32 chars).",
                      "examples": [
                        "re_01jbz9k3m4n5p6q7r8s9t0v1w2"
                      ],
                      "pattern": "^re_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Refund created by a `reject` of a settled amount (draft, merchant signs)."
                }
              },
              "required": [
                "decision",
                "decided_at",
                "refund"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "description": "Merchant decision on a `requires_review` intent (Stage 2)."
        },
        "review_reason": {
          "anyOf": [
            {
              "description": "Why the intent needs review.",
              "type": "string",
              "x-extensible-enum": [
                "short_settlement",
                "verification_held"
              ]
            },
            {
