{
  "$defs": {
    "EventReviewClosed": {
      "additionalProperties": {},
      "description": "`review.closed` event.",
      "properties": {
        "api_version": {
          "description": "API version the payload is rendered in.",
          "enum": [
            "2026-11-01"
          ],
          "type": "string"
        },
        "created": {
          "description": "Unix time in seconds.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "data": {
          "additionalProperties": {},
          "description": "Event data.",
          "properties": {
            "object": {
              "$ref": "#/$defs/Review"
            },
            "previous_attributes": {
              "additionalProperties": {},
              "description": "Changed fields with their previous values (update events).",
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            }
          },
          "required": [
            "object"
          ],
          "type": "object"
        },
        "id": {
          "description": "event id (`evt_` + 26 base32 chars).",
          "examples": [
            "evt_01jbz9k3m4n5p6q7r8s9t0v1w2"
          ],
          "pattern": "^evt_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
          "type": "string"
        },
        "livemode": {
          "description": "`true` for live mode, `false` for test mode.",
          "type": "boolean"
        },
        "object": {
          "const": "event",
          "description": "Always `event`.",
          "type": "string"
        },
        "request": {
          "additionalProperties": {},
          "description": "Request that caused the event.",
          "properties": {
            "id": {
              "anyOf": [
                {
                  "description": "request id (`req_` + 26 base32 chars).",
                  "examples": [
                    "req_01jbz9k3m4n5p6q7r8s9t0v1w2"
                  ],
                  "pattern": "^req_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "API request that caused the event, if any."
            },
            "idempotency_key": {
              "description": "Idempotency-Key of that request, if any.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "idempotency_key"
          ],
          "type": "object"
        },
        "type": {
          "const": "review.closed",
          "description": "Event type.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "object",
        "type",
        "api_version",
        "created",
        "livemode",
        "data",
        "request"
      ],
      "type": "object"
    },
    "Review": {
      "additionalProperties": {},
      "description": "A compliance review of a payment (payment stands; INV-1).",
      "properties": {
        "account_id": {
          "description": "account id (`acct_` + 26 base32 chars).",
          "examples": [
            "acct_01jbz9k3m4n5p6q7r8s9t0v1w2"
          ],
          "pattern": "^acct_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
          "type": "string"
        },
        "closed_at": {
          "anyOf": [
            {
              "description": "RFC 3339 UTC timestamp, e.g. `2026-11-05T10:00:00.000Z`.",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Closed."
        },
        "id": {
          "description": "compliance_case id (`case_` + 26 base32 chars).",
          "examples": [
            "case_01jbz9k3m4n5p6q7r8s9t0v1w2"
          ],
          "pattern": "^case_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
          "type": "string"
        },
        "object": {
          "const": "review",
          "description": "Always `review`.",
          "type": "string"
        },
        "opened_at": {
          "description": "Opened.",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        "reason": {
          "description": "Why.",
          "type": "string",
          "x-extensible-enum": [
            "post_screen_hit",
            "held_execution",
            "audit_mismatch",
            "screening_hit"
          ]
        },
        "status": {
          "description": "Review status.",
          "type": "string",
          "x-extensible-enum": [
            "open",
            "closed"
          ]
        },
        "subject": {
          "additionalProperties": {},
          "description": "What is under review.",
          "properties": {
            "id": {
              "description": "Reviewed object id.",
              "type": "string"
            },
            "type": {
              "description": "Reviewed object type (`execution`: a rails execution; payments maps it to its payment intent).",
              "type": "string",
              "x-extensible-enum": [
                "payment_intent",
                "agent_payment",
                "settlement_destination",
                "execution"
              ]
            }
          },
          "required": [
            "type",
            "id"
          ],
          "type": "object"
        }
      },
      "required": [
        "id",
        "object",
        "account_id",
        "subject",
        "reason",
        "status",
        "opened_at",
        "closed_at"
      ],
      "type": "object"
    }
  },
  "$ref": "#/$defs/EventReviewClosed",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
