{
  "$defs": {
    "EventPing": {
      "additionalProperties": {},
      "description": "`ping` event.",
      "properties": {
        "api_version": {
          "description": "API version the payload is rendered in.",
          "enum": [
            "2026-11-01"
          ],
          "type": "string"
        },
        "created": {
          "description": "Unix time in seconds.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "data": {
          "additionalProperties": {},
          "description": "Event data.",
          "properties": {
            "object": {
              "$ref": "#/$defs/Ping"
            },
            "previous_attributes": {
              "additionalProperties": {},
              "description": "Changed fields with their previous values (update events).",
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            }
          },
          "required": [
            "object"
          ],
          "type": "object"
        },
        "id": {
          "description": "event id (`evt_` + 26 base32 chars).",
          "examples": [
            "evt_01jbz9k3m4n5p6q7r8s9t0v1w2"
          ],
          "pattern": "^evt_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
          "type": "string"
        },
        "livemode": {
          "description": "`true` for live mode, `false` for test mode.",
          "type": "boolean"
        },
        "object": {
          "const": "event",
          "description": "Always `event`.",
          "type": "string"
        },
        "request": {
          "additionalProperties": {},
          "description": "Request that caused the event.",
          "properties": {
            "id": {
              "anyOf": [
                {
                  "description": "request id (`req_` + 26 base32 chars).",
                  "examples": [
                    "req_01jbz9k3m4n5p6q7r8s9t0v1w2"
                  ],
                  "pattern": "^req_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "API request that caused the event, if any."
            },
            "idempotency_key": {
              "description": "Idempotency-Key of that request, if any.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "idempotency_key"
          ],
          "type": "object"
        },
        "type": {
          "const": "ping",
          "description": "Event type.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "object",
        "type",
        "api_version",
        "created",
        "livemode",
        "data",
        "request"
      ],
      "type": "object"
    },
    "Ping": {
      "additionalProperties": {},
      "description": "Test delivery to a webhook endpoint.",
      "properties": {
        "object": {
          "const": "ping",
          "description": "Always `ping`.",
          "type": "string"
        },
        "webhook_endpoint": {
          "description": "webhook_endpoint id (`we_` + 26 base32 chars).",
          "examples": [
            "we_01jbz9k3m4n5p6q7r8s9t0v1w2"
          ],
          "pattern": "^we_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
          "type": "string"
        }
      },
      "required": [
        "object",
        "webhook_endpoint"
      ],
      "type": "object"
    }
  },
  "$ref": "#/$defs/EventPing",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
