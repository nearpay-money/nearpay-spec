            ],
            "pattern": "^txr_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
            "type": "string"
          },
          "type": "array"
        },
        "type": {
          "description": "A one-off line or a subscription item's line.",
          "type": "string",
          "x-extensible-enum": [
            "invoiceitem",
            "subscription"
          ]
        },
        "unit_amount": {
          "anyOf": [
            {
              "description": "Fiat amount in minor units (e.g. cents), integer.",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "description": "Asset amount in base units as a decimal string (no sign, no decimals, ≤ 78 digits).",
              "pattern": "^(0|[1-9][0-9]{0,77})$",
              "type": "string"
            }
          ],
          "description": "Price per unit in the invoice currency."
        }
      },
      "required": [
        "id",
        "object",
        "type",
        "price",
        "product",
        "subscription_item",
        "description",
        "quantity",
        "unit_amount",
        "amount",
        "amount_excluding_tax",
        "tax_rates",
        "tax_amounts",
        "period"
      ],
      "type": "object"
    },
    "InvoiceTaxAmount": {
      "additionalProperties": {},
      "description": "One tax rate applied to an amount (snapshot; immutable once open).",
      "properties": {
        "amount": {
          "anyOf": [
            {
              "description": "Fiat amount in minor units (e.g. cents), integer.",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "description": "Asset amount in base units as a decimal string (no sign, no decimals, ≤ 78 digits).",
              "pattern": "^(0|[1-9][0-9]{0,77})$",
              "type": "string"
            }
          ],
          "description": "Tax of this line for this rate, rounded half-up per line."
        },
        "display_name": {
          "description": "Tax-rate name at finalize (snapshot).",
          "type": "string"
        },
        "inclusive": {
          "description": "The line amount contains this tax.",
          "type": "boolean"
        },
        "percentage": {
          "description": "Exact percentage as a decimal string, 0–100 with at most 4 decimals (the rate is the rational `ppm / 1 000 000`, ppm = percentage × 10 000). No floats.",
          "examples": [
            "19",
            "8.875"
          ],
          "pattern": "^(100(\\.0{1,4})?|[1-9]?[0-9](\\.[0-9]{1,4})?)$",
          "type": "string"
        },
        "tax_rate": {
          "description": "tax_rate id (`txr_` + 26 base32 chars).",
          "examples": [
            "txr_01jbz9k3m4n5p6q7r8s9t0v1w2"
          ],
          "pattern": "^txr_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
          "type": "string"
        },
        "taxable_amount": {
          "anyOf": [
            {
              "description": "Fiat amount in minor units (e.g. cents), integer.",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "description": "Asset amount in base units as a decimal string (no sign, no decimals, ≤ 78 digits).",
              "pattern": "^(0|[1-9][0-9]{0,77})$",
              "type": "string"
            }
          ],
          "description": "Amount the rate applies to: the line amount (exclusive) or the line amount less its inclusive taxes."
        }
      },
      "required": [
        "tax_rate",
        "display_name",
        "percentage",
        "inclusive",
        "amount",
        "taxable_amount"
      ],
      "type": "object"
    }
