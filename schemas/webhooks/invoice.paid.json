          "type": "string"
        },
        "period": {
          "anyOf": [
            {
              "additionalProperties": {},
              "properties": {
                "end": {
                  "description": "Period end (exclusive).",
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "start": {
                  "description": "Period start.",
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
