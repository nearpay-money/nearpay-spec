{
  "$defs": {
    "Account": {
      "additionalProperties": {},
      "description": "A merchant account.",
      "properties": {
        "api_version": {
          "description": "API version pinned for this account.",
          "enum": [
            "2026-11-01"
          ],
          "type": "string"
        },
        "country": {
          "anyOf": [
            {
              "description": "ISO 3166-1 alpha-2 country code, upper-case.",
              "pattern": "^[A-Z]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Country of the merchant."
        },
        "created": {
          "description": "Unix time in seconds.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "display_name": {
          "description": "Name shown to payers until KYB verifies a legal name.",
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        "fee_bearer": {
          "description": "Who bears NearPay's fee: the payer pays it on top (default) or it is deducted from the settlement.",
          "enum": [
            "payer",
            "merchant"
          ],
          "type": "string"
        },
        "id": {
          "description": "account id (`acct_` + 26 base32 chars).",
          "examples": [
            "acct_01jbz9k3m4n5p6q7r8s9t0v1w2"
          ],
          "pattern": "^acct_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
          "type": "string"
        },
        "kyb_status": {
          "description": "KYB status.",
          "type": "string",
          "x-extensible-enum": [
            "not_started",
            "pending",
            "needs_info",
            "approved",
            "rejected"
          ]
        },
        "live_enabled": {
          "description": "Live mode is enabled: KYB approved, an active live destination, status active.",
          "type": "boolean"
        },
        "object": {
          "const": "account",
          "description": "Always `account`.",
          "type": "string"
        },
        "settings": {
          "$ref": "#/$defs/AccountSettings"
        },
        "status": {
          "description": "Account status.",
          "type": "string",
          "x-extensible-enum": [
            "active",
            "suspended",
            "closed"
          ]
        },
        "verified_legal_name": {
          "description": "Legal name approved by NearPay's KYB review (self-declared business details reviewed by ops), shown on checkout once set.",
          "type": [
            "string",
            "null"
          ]
        },
        "website": {
          "anyOf": [
            {
              "description": "Absolute URL.",
              "format": "uri",
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Merchant website (account setting, shown in the dashboard and receipts); absent from older servers."
        }
      },
      "required": [
        "id",
        "object",
        "created",
        "display_name",
        "verified_legal_name",
        "country",
        "status",
        "kyb_status",
        "live_enabled",
        "fee_bearer",
        "api_version",
        "settings"
      ],
      "type": "object"
    },
    "AccountSettings": {
      "additionalProperties": {},
      "description": "Merchant settings that change checkout behaviour.",
      "properties": {
        "branding": {
          "additionalProperties": {},
          "description": "Checkout branding.",
          "properties": {
            "accent_color": {
              "anyOf": [
                {
                  "pattern": "^#[0-9a-fA-F]{6}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Accent colour `#RRGGBB`."
            },
            "corner_radius": {
              "description": "Corner radius of checkout cards and controls, px (default 8); absent from older servers.",
              "maximum": 24,
              "minimum": 0,
              "type": "integer"
            },
            "logo_url": {
              "anyOf": [
                {
                  "description": "Absolute URL.",
                  "format": "uri",
                  "maxLength": 2048,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "HTTPS URL of a square logo."
            },
            "theme": {
              "description": "Checkout colour scheme (default `auto`); absent from older servers.",
              "type": "string",
              "x-extensible-enum": [
                "auto",
                "light",
                "dark"
              ]
            }
          },
          "required": [
            "accent_color",
            "logo_url"
          ],
          "type": "object"
        },
        "email_receipts": {
          "description": "Email a receipt to the customer when a payment succeeds.",
          "type": "boolean"
        },
        "late_payments": {
          "description": "Accept settlements that arrive after a session expired (INV-3); default false.",
          "type": "boolean"
        },
        "session_ttl_default": {
          "description": "Default checkout-session lifetime in seconds.",
          "maximum": 86400,
          "minimum": 300,
          "type": "integer"
        },
        "underpay_tolerance_bps": {
          "description": "Accept short settlements within this tolerance (0–100 bps); default 0.",
          "maximum": 10000,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "late_payments",
        "underpay_tolerance_bps",
        "session_ttl_default",
        "email_receipts",
        "branding"
      ],
      "type": "object"
    },
    "EventAccountUpdated": {
      "additionalProperties": {},
      "description": "`account.updated` event.",
      "properties": {
        "api_version": {
          "description": "API version the payload is rendered in.",
          "enum": [
            "2026-11-01"
          ],
          "type": "string"
        },
        "created": {
          "description": "Unix time in seconds.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "data": {
          "additionalProperties": {},
          "description": "Event data.",
          "properties": {
            "object": {
              "$ref": "#/$defs/Account"
            },
            "previous_attributes": {
              "additionalProperties": {},
              "description": "Changed fields with their previous values (update events).",
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            }
          },
          "required": [
            "object"
          ],
          "type": "object"
        },
        "id": {
          "description": "event id (`evt_` + 26 base32 chars).",
          "examples": [
            "evt_01jbz9k3m4n5p6q7r8s9t0v1w2"
          ],
          "pattern": "^evt_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
          "type": "string"
        },
        "livemode": {
          "description": "`true` for live mode, `false` for test mode.",
          "type": "boolean"
        },
        "object": {
          "const": "event",
          "description": "Always `event`.",
          "type": "string"
        },
        "request": {
          "additionalProperties": {},
          "description": "Request that caused the event.",
          "properties": {
            "id": {
              "anyOf": [
                {
                  "description": "request id (`req_` + 26 base32 chars).",
                  "examples": [
                    "req_01jbz9k3m4n5p6q7r8s9t0v1w2"
                  ],
                  "pattern": "^req_[0-7][0123456789abcdefghjkmnpqrstvwxyz]{25}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "API request that caused the event, if any."
            },
            "idempotency_key": {
              "description": "Idempotency-Key of that request, if any.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "idempotency_key"
          ],
          "type": "object"
        },
        "type": {
          "const": "account.updated",
          "description": "Event type.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "object",
        "type",
        "api_version",
        "created",
        "livemode",
        "data",
        "request"
      ],
      "type": "object"
    }
  },
  "$ref": "#/$defs/EventAccountUpdated",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
