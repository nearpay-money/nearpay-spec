{
  "$defs": {
    "Erc191MultiPayload": {
      "additionalProperties": {},
      "description": "Payload signed with ERC-191.",
      "properties": {
        "payload": {
          "description": "JSON string of `IntentMessage`.",
          "minLength": 2,
          "type": "string"
        },
        "signature": {
          "description": "secp256k1 signature r‖s‖v (v ∈ {0,1}), base58.",
          "pattern": "^(ed25519|secp256k1):[1-9A-HJ-NP-Za-km-z]{64,100}$",
          "type": "string"
        },
        "standard": {
          "const": "erc191",
          "description": "ERC-191 `personal_sign` (EVM wallets).",
          "type": "string"
        }
      },
      "required": [
        "standard",
        "payload",
        "signature"
      ],
      "type": "object"
    },
    "MultiPayload": {
      "description": "A signed Verifier payload (`MultiPayload`).",
      "oneOf": [
        {
          "$ref": "#/$defs/Nep413MultiPayload"
        },
        {
          "$ref": "#/$defs/Erc191MultiPayload"
        },
        {
          "$ref": "#/$defs/RawEd25519MultiPayload"
        }
      ]
    },
    "Nep413MultiPayload": {
      "additionalProperties": {},
      "description": "Payload signed with NEP-413.",
      "properties": {
        "payload": {
          "additionalProperties": {},
          "description": "NEP-413 payload.",
          "properties": {
            "callbackUrl": {
              "description": "NEP-413 callback URL (NearPay never sets it).",
              "type": [
                "string",
                "null"
              ]
            },
            "message": {
              "description": "JSON string of `Nep413IntentMessage`.",
              "minLength": 2,
              "type": "string"
            },
            "nonce": {
              "description": "32-byte nonce (4-byte Verifier salt ‖ 28 random bytes), standard base64.",
              "pattern": "^[A-Za-z0-9+/]{43}=$",
              "type": "string"
            },
            "recipient": {
              "const": "intents.near",
              "description": "NEP-413 recipient (the Verifier).",
              "type": "string"
            }
          },
          "required": [
            "recipient",
            "nonce",
            "message"
          ],
          "type": "object"
        },
        "public_key": {
          "description": "ed25519 key of the signer.",
          "pattern": "^(ed25519|secp256k1):[1-9A-HJ-NP-Za-km-z]{32,90}$",
          "type": "string"
        },
        "signature": {
          "description": "ed25519 signature over the NEP-413 borsh hash.",
          "pattern": "^(ed25519|secp256k1):[1-9A-HJ-NP-Za-km-z]{64,100}$",
          "type": "string"
        },
        "standard": {
          "const": "nep413",
          "description": "NEP-413 (NEAR wallets `signMessage`).",
          "type": "string"
        }
      },
      "required": [
        "standard",
        "payload",
        "public_key",
        "signature"
      ],
      "type": "object"
    },
    "RawEd25519MultiPayload": {
      "additionalProperties": {},
      "description": "Payload signed with raw ed25519.",
      "properties": {
        "payload": {
          "description": "JSON string of `IntentMessage`.",
          "minLength": 2,
          "type": "string"
        },
        "public_key": {
          "description": "ed25519 key of the signer.",
          "pattern": "^(ed25519|secp256k1):[1-9A-HJ-NP-Za-km-z]{32,90}$",
          "type": "string"
        },
        "signature": {
          "description": "ed25519 signature over the UTF-8 payload.",
          "pattern": "^(ed25519|secp256k1):[1-9A-HJ-NP-Za-km-z]{64,100}$",
          "type": "string"
        },
        "standard": {
          "const": "raw_ed25519",
          "description": "Raw ed25519 over the payload bytes (agents).",
          "type": "string"
        }
      },
      "required": [
        "standard",
        "payload",
        "public_key",
        "signature"
      ],
      "type": "object"
    },
    "X402IntentsTransferExtra": {
      "additionalProperties": {},
      "description": "NearPay `intents-transfer` requirement details.",
      "properties": {
        "assetTransferMethod": {
          "const": "intents-transfer",
          "description": "NearPay transfer method.",
          "type": "string"
        },
        "binding": {
          "description": "Binding memo `np1:` + base58(sha256(…)) tying a signed transfer to one requirement.",
          "pattern": "^np1:[1-9A-HJ-NP-Za-km-z]{43,44}$",
          "type": "string"
        },
        "deadline": {
          "description": "Absolute expiry of this issued requirement (RFC 3339; the binding's `expires_at`). Sign a Verifier `deadline` at or before it; absent from facilitators older than spec 0.1.5, then derive the window from `maxTimeoutSeconds`.",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        "fee": {
          "additionalProperties": {},
          "description": "NearPay fee transfer the payload must also contain.",
          "properties": {
            "amount": {
              "description": "Fee in base units of the same asset.",
              "pattern": "^(0|[1-9][0-9]{0,77})$",
              "type": "string"
            },
            "to": {
              "description": "NearPay treasury Intents account.",
              "pattern": "^(?=.{2,64}$)(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+$",
              "type": "string"
            }
          },
          "required": [
            "to",
            "amount"
          ],
          "type": "object"
        },
        "paymentFlow": {
          "const": "authorization",
          "description": "Payer signs; facilitator relays.",
          "type": "string"
        },
        "verifyingContract": {
          "const": "intents.near",
          "description": "Verifier contract.",
          "type": "string"
        }
      },
      "required": [
        "assetTransferMethod",
        "paymentFlow",
        "fee",
        "binding",
        "verifyingContract"
      ],
      "type": "object"
    },
    "X402PaymentPayload": {
      "additionalProperties": {},
      "description": "Body of `PAYMENT-SIGNATURE` (base64 JSON).",
      "properties": {
        "accepted": {
          "$ref": "#/$defs/X402PaymentRequirements",
          "description": "The requirement the payer chose (must equal one in `accepts`)."
        },
        "extensions": {
          "additionalProperties": {},
          "description": "Protocol extensions.",
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "payload": {
          "additionalProperties": {},
          "description": "Signed Verifier payload with exactly the two transfers.",
          "properties": {
            "signed": {
              "$ref": "#/$defs/MultiPayload"
            }
          },
          "required": [
            "signed"
          ],
          "type": "object"
        },
        "resource": {
          "$ref": "#/$defs/X402ResourceInfo"
        },
        "x402Version": {
          "const": 2,
          "description": "x402 protocol version.",
          "type": "number"
        }
      },
      "required": [
        "x402Version",
        "accepted",
        "payload"
      ],
      "type": "object"
    },
    "X402PaymentRequirements": {
      "additionalProperties": {},
      "description": "One accepted way to pay (`accepts[]` entry).",
      "properties": {
        "amount": {
          "description": "Amount the merchant receives, base units.",
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "type": "string"
        },
        "asset": {
          "description": "Asset to pay (NEAR Intents asset id).",
          "examples": [
            "nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1"
          ],
          "maxLength": 256,
          "pattern": "^(nep141:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+|nep245:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+:[\\x21-\\x7e]{1,128})$",
          "type": "string"
        },
        "extra": {
          "$ref": "#/$defs/X402IntentsTransferExtra"
        },
        "maxTimeoutSeconds": {
          "description": "Payment must be settled within this time.",
          "maximum": 300,
          "minimum": 30,
          "type": "integer"
        },
        "network": {
          "const": "near:mainnet",
          "description": "Network.",
          "type": "string"
        },
        "payTo": {
          "description": "Merchant Intents account.",
          "pattern": "^(?=.{2,64}$)(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+$",
          "type": "string"
        },
        "scheme": {
          "const": "exact",
          "description": "x402 scheme.",
          "type": "string"
        }
      },
      "required": [
        "scheme",
        "network",
        "amount",
        "asset",
        "payTo",
        "maxTimeoutSeconds",
        "extra"
      ],
      "type": "object"
    },
    "X402ResourceInfo": {
      "additionalProperties": {},
      "description": "The resource a payment unlocks.",
      "properties": {
        "description": {
          "description": "What is being paid for.",
          "maxLength": 500,
          "type": "string"
        },
        "mimeType": {
          "description": "MIME type of the resource.",
          "maxLength": 100,
          "type": "string"
        },
        "url": {
          "description": "URL of the paid resource.",
          "format": "uri",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    }
  },
  "$ref": "#/$defs/X402PaymentPayload",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
