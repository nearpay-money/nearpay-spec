{
  "$defs": {
    "X402IntentsTransferExtra": {
      "additionalProperties": {},
      "description": "NearPay `intents-transfer` requirement details.",
      "properties": {
        "assetTransferMethod": {
          "const": "intents-transfer",
          "description": "NearPay transfer method.",
          "type": "string"
        },
        "binding": {
          "description": "Binding memo `np1:` + base58(sha256(…)) tying a signed transfer to one requirement.",
          "pattern": "^np1:[1-9A-HJ-NP-Za-km-z]{43,44}$",
          "type": "string"
        },
        "deadline": {
          "description": "Absolute expiry of this issued requirement (RFC 3339; the binding's `expires_at`). Sign a Verifier `deadline` at or before it; absent from facilitators older than spec 0.1.5, then derive the window from `maxTimeoutSeconds`.",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        "fee": {
          "additionalProperties": {},
          "description": "NearPay fee transfer the payload must also contain.",
          "properties": {
            "amount": {
              "description": "Fee in base units of the same asset.",
              "pattern": "^(0|[1-9][0-9]{0,77})$",
              "type": "string"
            },
            "to": {
              "description": "NearPay treasury Intents account.",
              "pattern": "^(?=.{2,64}$)(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+$",
              "type": "string"
            }
          },
          "required": [
            "to",
            "amount"
          ],
          "type": "object"
        },
        "paymentFlow": {
          "const": "authorization",
          "description": "Payer signs; facilitator relays.",
          "type": "string"
        },
        "verifyingContract": {
          "const": "intents.near",
          "description": "Verifier contract.",
          "type": "string"
        }
      },
      "required": [
        "assetTransferMethod",
        "paymentFlow",
        "fee",
        "binding",
        "verifyingContract"
      ],
      "type": "object"
    },
    "X402PaymentRequirements": {
      "additionalProperties": {},
      "description": "One accepted way to pay (`accepts[]` entry).",
      "properties": {
        "amount": {
          "description": "Amount the merchant receives, base units.",
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "type": "string"
        },
        "asset": {
          "description": "Asset to pay (NEAR Intents asset id).",
          "examples": [
            "nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1"
          ],
          "maxLength": 256,
          "pattern": "^(nep141:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+|nep245:(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+:[\\x21-\\x7e]{1,128})$",
          "type": "string"
        },
        "extra": {
          "$ref": "#/$defs/X402IntentsTransferExtra"
        },
        "maxTimeoutSeconds": {
          "description": "Payment must be settled within this time.",
          "maximum": 300,
          "minimum": 30,
          "type": "integer"
        },
        "network": {
          "const": "near:mainnet",
          "description": "Network.",
          "type": "string"
        },
        "payTo": {
          "description": "Merchant Intents account.",
          "pattern": "^(?=.{2,64}$)(([a-z\\d]+[-_])*[a-z\\d]+\\.)*([a-z\\d]+[-_])*[a-z\\d]+$",
          "type": "string"
        },
        "scheme": {
          "const": "exact",
          "description": "x402 scheme.",
          "type": "string"
        }
      },
      "required": [
        "scheme",
        "network",
        "amount",
        "asset",
        "payTo",
        "maxTimeoutSeconds",
        "extra"
      ],
      "type": "object"
    }
  },
  "$ref": "#/$defs/X402PaymentRequirements",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
